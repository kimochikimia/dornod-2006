<%- include('../partials/head') %>
<%
  var phaseClass = { onsale: 'grad', soon: 'pending', soldout: 'danger', ended: '', draft: '' };
  var current = events.filter(function (e) { return e.phase !== 'ended'; });
  var past = events.filter(function (e) { return e.phase === 'ended'; });
  var cta = function (e) {
    return { onsale: 'Тасалбар авах', soon: 'Удахгүй', soldout: 'Дууссан', ended: 'Дууссан', draft: 'Ноорог' }[e.phase];
  };
  // Картын нимгэн дүрс тэмдэг (outline)
  var svgI = function (d) { return '<svg class="tk-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="' + d + '"/></svg>'; };
  var icon = {
    pin: svgI('M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z M12 12.2a2.6 2.6 0 1 0 0-5.2 2.6 2.6 0 0 0 0 5.2z'),
    cal: svgI('M4 6.5A1.5 1.5 0 0 1 5.5 5h13A1.5 1.5 0 0 1 20 6.5v12a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5z M4 10h16 M8 3v4 M16 3v4 M8 14h3 M8 17h6'),
    tag: svgI('M3.5 12.3V4.5a1 1 0 0 1 1-1h7.8l8.2 8.2a1.4 1.4 0 0 1 0 2l-6.6 6.6a1.4 1.4 0 0 1-2 0z M8 8.5h.01'),
  };
  var poster = function (e, size) { return '/tickets/' + e.id + '/poster?' + (size ? 's=t&' : '') + 'v=' + e.poster_v; };
%>
<div class="container">
  <div class="page-head row between">
    <div>
      <h1>Тасалбар</h1>
    </div>
    <div class="row" style="gap:.5rem">
      <% if (me) { %><a class="btn" href="/tickets/mine">🎟️ Миний тасалбар</a><% } %>
      <% if (can('manage_tickets')) { %><a class="btn btn-primary" href="/admin/tickets/new">+ Арга хэмжээ</a><% } %>
    </div>
  </div>

  <% if (!events.length) { %>
    <div class="empty">Одоогоор тасалбартай арга хэмжээ алга.</div>
  <% } %>

  <% [['Арга хэмжээ', current], ['Өнгөрсөн', past]].forEach(function (sec) { if (!sec[1].length) return; %>
    <h2 class="tk-section-h"><%= sec[0] %> <span class="muted small">(<%= sec[1].length %>)</span></h2>
    <div class="tk-grid">
      <% sec[1].forEach(function (e) { %>
        <a class="tk-pcard<%= e.phase === 'ended' ? ' is-closed' : '' %>" href="/tickets/<%= e.id %>">
          <div class="tk-pcard-img">
            <% if (e.poster_v) { %>
              <img src="<%= poster(e, true) %>" alt="<%= e.title %> — постер" loading="lazy">
            <% } else { %>
              <div class="tk-pcard-noimg">
                <span class="tk-day"><%= e.eventText.slice(8, 10) %></span>
                <span class="tk-month"><%= e.eventText.slice(0, 7) %></span>
              </div>
            <% } %>
            <% if (e.phase !== 'onsale') { %><span class="badge <%= phaseClass[e.phase] %> tk-pcard-badge"><%= tk.PHASE_LABELS[e.phase] %></span><% } %>
          </div>
          <div class="tk-pcard-body">
            <h3 title="<%= e.title %>"><%= e.title %></h3>
            <% if (e.venue) { %><div class="tk-pcard-row"><%- icon.pin %><span><%= e.venue %></span></div><% } %>
            <div class="tk-pcard-row"><%- icon.cal %><span><%= e.eventText %></span></div>
            <div class="tk-pcard-row tk-pcard-price"><%- icon.tag %><span><%= e.priceText %></span></div>
            <span class="tk-pcard-btn<%= e.onSale ? '' : ' off' %>"><%= cta(e) %></span>
          </div>
        </a>
      <% }) %>
    </div>
  <% }) %>
</div>
<script src="/js/tickets.js" defer></script>
<%- include('../partials/foot') %>
