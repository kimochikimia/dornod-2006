<%- include('../partials/head') %>
<%
  var e = event;
  var f = form || {};
  var phaseClass = { onsale: 'grad', soon: 'pending', soldout: 'danger', ended: '', draft: '' };
  var seated = e.seating === 'seated';
  var canBuy = e.onSale && me && me.status === 'approved';
%>
<%
  // Тасалбарын үнийн төрлүүд: суудалтай бол хэсэг (сектор/эгнээ/ширээ) бүрээр, олон бол үнээр нь нэгтгэнэ
  var tiers = [];
  if (seated && e.seatList.length) {
    var byGroup = {}, order = [];
    e.seatList.forEach(function (st) {
      var k = st.group + '|' + st.price;
      if (!byGroup[k]) { byGroup[k] = { name: st.group, price: st.price, n: 0 }; order.push(k); }
      byGroup[k].n++;
    });
    tiers = order.map(function (k) { return byGroup[k]; });
    if (tiers.length > 8) {
      var byPrice = {};
      tiers.forEach(function (t) { byPrice[t.price] = (byPrice[t.price] || 0) + t.n; });
      tiers = Object.keys(byPrice).map(Number).sort(function (a, b) { return b - a; })
        .map(function (pr) { return { name: byPrice[pr] + ' суудал', price: pr }; });
    }
  } else {
    tiers = [{ name: 'Тасалбар', price: e.price }];
  }
  // Байршлын газрын зураг: линкэн дэх координат (@lat,lng), эс бөгөөс байршлын нэрээр
  var mapQ = null;
  var coord = e.venue_url && /@(-?\d+\.\d+),(-?\d+\.\d+)/.exec(e.venue_url);
  if (coord) mapQ = coord[1] + ',' + coord[2];
  else if (e.venue) mapQ = e.venue;
%>
<div class="container tk-detail">
  <a href="/tickets" class="small">← Бүх арга хэмжээ</a>

  <% if (e.poster_v) { %>
    <a class="tk-banner" href="/tickets/<%= e.id %>/poster?v=<%= e.poster_v %>" data-lightbox data-caption="<%= e.title %>">
      <img class="tk-banner-bg" src="/tickets/<%= e.id %>/poster?s=t&v=<%= e.poster_v %>" alt="" aria-hidden="true">
      <img class="tk-banner-img" src="/tickets/<%= e.id %>/poster?v=<%= e.poster_v %>" alt="<%= e.title %> — постер">
    </a>
  <% } %>

  <% if (errors.length) { %><div class="flash error"><% errors.forEach(function (m) { %><div><%= m %></div><% }) %></div><% } %>

  <div class="cmp-layout">
    <div class="cmp-main">
      <div class="tk-title row between">
        <div>
          <span class="badge <%= phaseClass[e.phase] %>"><%= tk.PHASE_LABELS[e.phase] %></span>
          <h1><%= e.title %></h1>
        </div>
        <% if (can('manage_tickets') || can('sell_tickets') || can('confirm_tickets')) { %><a class="btn btn-sm" href="/admin/tickets/<%= e.id %><%= can('confirm_tickets') ? '' : can('sell_tickets') ? '/sell' : '/edit' %>">✎ Удирдах<%= e.pending_orders ? ' (' + e.pending_orders + ' хүлээгдэж буй)' : '' %></a><% } %>
      </div>

      <div class="tk-facts">
        <ul class="tk-facts-list">
          <% if (e.venue) { %><li><span class="tk-fi">📍</span><span class="tk-fl">Хаана:</span><strong><% if (e.venue_url) { %><a href="<%= e.venue_url %>" target="_blank" rel="noopener noreferrer"><%= e.venue %></a><% } else { %><%= e.venue %><% } %></strong></li><% } %>
          <li><span class="tk-fi">📅</span><span class="tk-fl">Хэзээ:</span><strong><%= e.eventText %></strong></li>
          <li><span class="tk-fi">🗓️</span><span class="tk-fl">Худалдаа:</span><strong><%= e.saleText %></strong></li>
          <% if (e.left != null) { %><li><span class="tk-fi">🎟️</span><span class="tk-fl">Үлдсэн:</span><strong><%= e.left %> / <%= e.total %></strong></li><% } %>
          <% if (e.contact) { %><li><span class="tk-fi">📞</span><span class="tk-fl">Холбоо барих:</span><strong><%= e.contact %></strong></li><% } %>
        </ul>
        <div class="tk-prices">
          <div class="tk-fl">💳 Тасалбарын үнэ:</div>
          <% tiers.forEach(function (t) { %>
            <div class="tk-price-row"><span><%= t.name %></span><strong><%= t.price ? tk.fmtMoney(t.price) : 'Үнэгүй' %></strong></div>
          <% }) %>
        </div>
      </div>

      <hr class="tk-rule">

      <% if (e.summary || e.body) { %>
        <section class="tk-sec">
          <h2>Дэлгэрэнгүй мэдээлэл</h2>
          <% if (e.summary) { %><p class="cmp-summary"><%= e.summary %></p><% } %>
          <% if (e.body) { %><div class="prose"><%- h.text(e.body) %></div><% } %>
        </section>
      <% } %>

      <% if (seated) { %>
        <section class="card" id="seats">
          <div class="row between" style="margin-bottom:.5rem">
            <h2 style="margin:0">Суудлын план</h2>
            <div class="seat-legend small">
              <span><i class="sw free"></i>Сул</span>
              <span><i class="sw sel"></i>Сонгосон</span>
              <span><i class="sw pending"></i>Захиалагдсан</span>
              <span><i class="sw held"></i>Түгжсэн</span>
              <span><i class="sw paid"></i>Зарагдсан</span>
              <% if (me) { %><span><i class="sw mine"></i>Миний</span><% } %>
            </div>
          </div>
          <div class="seat-map-wrap" data-seat-map data-mode="<%= canBuy ? 'pick' : 'view' %>" data-form="buy-form">
            <script type="application/json" data-map-json><%- mapJson %></script>
          </div>
        </section>
      <% } %>

      <% if (mapQ) { %>
        <section class="tk-sec">
          <h2>Байршил</h2>
          <div class="tk-map">
            <iframe src="https://maps.google.com/maps?q=<%= encodeURIComponent(mapQ) %>&z=16&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="<%= e.venue || 'Байршил' %> — газрын зураг" allowfullscreen></iframe>
          </div>
          <% if (e.venue_url) { %><a class="small" href="<%= e.venue_url %>" target="_blank" rel="noopener noreferrer">🗺️ Google Maps-д нээх</a><% } %>
        </section>
      <% } %>
    </div>

    <aside class="cmp-side">
      <div class="card" id="buy">
        <h3>Тасалбар авах</h3>
        <% if (e.phase === 'draft') { %>
          <p class="small muted" style="margin:0">Ноорог — нийтлэгдээгүй байна.</p>
        <% } else if (e.phase === 'soon') { %>
          <p class="small muted" style="margin:0">Худалдаа <strong><%= h.fmtDate(e.sale_start) %></strong>-д эхэлнэ.</p>
        <% } else if (e.phase === 'soldout') { %>
          <p class="small muted" style="margin:0">Тасалбар дууссан. Төлөгдөөгүй захиалгын хугацаа дуусвал дахин гарч магадгүй.</p>
        <% } else if (e.phase === 'ended') { %>
          <p class="small muted" style="margin:0">Тасалбарын худалдаа хаагдсан.</p>
        <% } else if (!me) { %>
          <p class="small muted">Тасалбар авахын тулд нэвтэрнэ үү.</p>
          <a class="btn btn-primary btn-sm" href="/login?next=<%= encodeURIComponent('/tickets/' + e.id) %>">Нэвтрэх</a>
        <% } else if (me.status !== 'approved') { %>
          <p class="small muted" style="margin:0">Таны бүртгэл баталгаажсаны дараа тасалбар авах боломжтой.</p>
        <% } else { %>
          <form method="post" action="/tickets/<%= e.id %>/buy" class="form support-form" id="buy-form" data-price="<%= e.price %>">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <% if (seated) { %>
              <input type="hidden" name="seats" value="" data-pick-input>
              <div class="tk-picked" data-pick-list><span class="small faint">Суудал сонгоогүй байна.</span></div>
            <% } else { %>
              <div class="field">
                <label>Тасалбарын тоо</label>
                <div class="qty" data-qty>
                  <button type="button" class="btn btn-sm" data-qty-step="-1" aria-label="Хасах">−</button>
                  <input type="number" name="quantity" value="<%= f.quantity || 1 %>" min="1" max="<%= Math.min(e.max_per_order, e.left == null ? 999 : e.left) %>" inputmode="numeric">
                  <button type="button" class="btn btn-sm" data-qty-step="1" aria-label="Нэмэх">+</button>
                </div>
              </div>
            <% } %>
            <div class="tk-total"><span>Нийт дүн</span><strong data-pick-total><%= seated ? '0₮' : tk.fmtMoney(e.price * (Number(f.quantity) || 1)) %></strong></div>
            <div class="field"><label>Утас</label><input type="tel" name="buyer_phone" value="<%= f.buyer_phone || me.phone || '' %>" maxlength="40"></div>
            <div class="field"><label>Тэмдэглэл <span class="small faint">(заавал биш)</span></label><input type="text" name="note" value="<%= f.note || '' %>" maxlength="500" placeholder="Жишээ нь: гэр бүлийн хамт"></div>
            <button class="btn btn-primary" type="submit" <%= seated ? 'disabled' : '' %> data-pick-submit>Захиалах</button>
            <% if (e.price > 0) { %><p class="small faint" style="margin:0">Захиалсны дараа <%= e.hold_hours %> цагийн дотор төлбөрөө шилжүүлнэ. Хугацаандаа төлөөгүй бол захиалга автоматаар цуцлагдана.</p><% } %>
          </form>
        <% } %>
      </div>

      <% if (mine.length) { %>
        <div class="card" id="mine">
          <h3>Миний захиалга</h3>
          <%
            // Суудлыг сектор/эгнээгээр бүлэглэж товчилно: "В сектор · 2 эгнээ: 1, 2, 3 суудал"
            var seatLines = function (o) {
              if (!o.seatArr.length) return [o.quantity + ' тасалбар'];
              var groups = {}, keys = [], rest = [];
              o.seatArr.forEach(function (st) {
                var m = /^(.*) · (\d+) эгнээ · (\d+) суудал$/.exec(st.label || '');
                if (!m) { rest.push(st.label); return; }
                var k = m[1] + ' · ' + m[2] + ' эгнээ';
                if (!groups[k]) { groups[k] = []; keys.push(k); }
                groups[k].push(Number(m[3]));
              });
              return keys.map(function (k) {
                return k + ': ' + groups[k].sort(function (a, b) { return a - b; }).join(', ') + ' суудал';
              }).concat(rest.length ? [rest.join(', ')] : []);
            };
          %>
          <div class="cmp-mine">
            <% mine.forEach(function (o) { %>
              <div class="cmp-mine-row">
                <dl class="tk-mine-dl">
                  <dt>Захиалгын дугаар</dt><dd><a href="/tickets/order/<%= o.code %>"><strong class="mono"><%= o.code %></strong></a></dd>
                  <dt>Захиалсан суудал</dt><dd><% seatLines(o).forEach(function (l) { %><div><%= l %></div><% }) %></dd>
                  <dt><%= o.status === 'paid' ? 'Төлсөн дүн' : 'Төлөх дүн' %></dt><dd><strong><%= tk.fmtMoney(o.amount) %></strong></dd>
                </dl>
                <% if (o.status === 'cancelled' && o.cancel_reason) { %><div class="small faint"><%= tk.CANCEL_LABELS[o.cancel_reason] %></div><% } %>
                <div class="tk-mine-foot">
                  <span class="badge <%= o.status === 'paid' ? 'success' : o.status === 'pending' ? 'pending' : 'danger' %>"><%= tk.STATUS_LABELS[o.statusKey] %></span>
                  <% if (o.status === 'pending' && o.expires_at) { %><span class="tk-expire" title="<%= h.fmtDate(o.expires_at) %> хүртэл төлнө">⏳ <strong data-countdown="<%= new Date(o.expires_at).toISOString() %>">—</strong></span><% } %>
                  <% if (o.status === 'pending' && o.amount > 0) { %><button type="button" class="btn btn-sm btn-primary tk-pay-btn" data-open-dialog="pay-<%= o.code %>">💳 Төлөх</button><% } %>
                </div>
              </div>
              <% if (o.status === 'pending' && o.amount > 0) { %>
                <dialog id="pay-<%= o.code %>" class="dialog tk-pay-dialog">
                  <div class="dialog-body">
                    <button type="button" class="modal-close" data-close-dialog aria-label="Хаах">&times;</button>
                    <h3>Төлбөр шилжүүлэх</h3>
                    <p class="small muted" style="margin-top:0">Гүйлгээний утгад <strong>захиалгын кодоо</strong> заавал бичнэ үү.</p>
                    <div class="tk-pay-grid">
                      <% if (e.bank_name) { %><div class="tk-pay-row"><span>Банк</span><strong><%= e.bank_name %></strong></div><% } %>
                      <div class="tk-pay-row"><span>Дансны дугаар</span><strong><%= e.bank_account || '—' %></strong><% if (e.bank_account) { %><button class="btn btn-sm" type="button" data-copy="<%= e.bank_account %>">Хуулах</button><% } %></div>
                      <% if (e.bank_holder) { %><div class="tk-pay-row"><span>Хүлээн авагч</span><strong><%= e.bank_holder %></strong></div><% } %>
                      <div class="tk-pay-row"><span>Дүн</span><strong><%= tk.fmtMoney(o.amount) %></strong><button class="btn btn-sm" type="button" data-copy="<%= o.amount %>">Хуулах</button></div>
                      <div class="tk-pay-row hl"><span>Гүйлгээний утга</span><strong><%= o.code %></strong><button class="btn btn-sm" type="button" data-copy="<%= o.code %>">Хуулах</button></div>
                    </div>
                    <% if (o.expires_at) { %>
                      <p class="small tk-expire" style="margin:.9rem 0 0">⏳ <strong><%= h.fmtDate(o.expires_at) %></strong>-аас өмнө төлнө үү · үлдсэн <strong data-countdown="<%= new Date(o.expires_at).toISOString() %>">—</strong></p>
                    <% } %>
                    <div class="row between" style="margin-top:1rem">
                      <a class="small" href="/tickets/order/<%= o.code %>">Захиалгын дэлгэрэнгүй →</a>
                      <button type="button" class="btn btn-sm" data-close-dialog>Хаах</button>
                    </div>
                  </div>
                </dialog>
              <% } %>
            <% }) %>
          </div>
        </div>
      <% } %>
    </aside>
  </div>
</div>
<% if (e.poster_v) { %><%- include('../partials/lightbox') %><% } %>
<script src="/js/seatmap.js" defer></script>
<script src="/js/tickets.js" defer></script>
<%- include('../partials/foot') %>
