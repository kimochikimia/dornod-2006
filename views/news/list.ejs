<%- include('../partials/head') %>
<div class="container">
  <div class="page-head">
    <h1>Мэдээ, зарлал</h1>
  </div>
  <% if (!news.length) { %>
    <div class="empty">Одоогоор мэдээ нийтлэгдээгүй байна.</div>
  <% } else { %>
    <div class="grid grid-2">
      <% news.forEach(function (n) { %>
        <%- include('../partials/news-card', { n: n }) %>
      <% }) %>
    </div>
  <% } %>
</div>
<%- include('../partials/foot') %>
