<%- include('../partials/head') %>
<div class="container">
  <div class="card auth-card glow">
    <% if (state === 'confirm') { %>
      <h1>И-мэйл баталгаажуулах</h1>
      <p class="muted">Энэ хаягийг өөрийн бүртгэлд баталгаажуулах бол доорх товчийг дарна уу.</p>
      <form method="post" action="/verify-email/<%= token %>" class="form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn btn-primary btn-lg" type="submit">Баталгаажуулах</button>
      </form>
    <% } else if (state === 'done') { %>
      <h1>И-мэйл баталгаажлаа</h1>
      <p class="muted">Одоо тасалбар, төлбөрийн мэдээлэл энэ хаягаар ирнэ.</p>
      <a class="btn btn-primary" href="<%= me ? '/me' : '/login' %>"><%= me ? 'Миний хуудас' : 'Нэвтрэх' %></a>
    <% } else { %>
      <h1>Холбоос хүчингүй байна</h1>
      <p class="muted">Холбоосын хугацаа дууссан эсвэл аль хэдийн ашиглагдсан байна. «Миний хуудас»-наас шинэ холбоос авна уу.</p>
      <a class="btn btn-primary" href="<%= me ? '/me#email' : '/login?next=%2Fme' %>"><%= me ? 'Миний хуудас' : 'Нэвтрэх' %></a>
    <% } %>
  </div>
</div>
<%- include('../partials/foot') %>
