<%- include('../partials/head') %>
<div class="container">
  <div class="card auth-card wide glow modal">
    <a href="/" class="modal-close" data-modal-close aria-label="Хаах" title="Хаах (Esc)">&times;</a>
    <h1>Бүртгүүлэх</h1>
    <p class="muted">Дорнод аймгийн сургуулиудыг 2006 онд төгссөн бол бүртгүүлээрэй. Админ таны мэдээллийг шалгаж баталгаажуулна.</p>
    <% if (errors.length) { %>
      <div class="flash error"><% errors.forEach(function (e) { %><div>• <%= e %></div><% }) %></div>
    <% } %>
    <form method="post" action="/register" class="form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="photo-picker" data-photo-picker>
        <div class="photo-preview" data-photo-preview>
          <% if (form.photo_data) { %><img src="<%= form.photo_data %>" alt=""><% } else { %><span>📷</span><% } %>
        </div>
        <div>
          <label class="btn btn-sm" for="photo_file">Зураг сонгох</label>
          <input id="photo_file" type="file" accept="image/jpeg,image/png,image/webp" data-photo-file hidden>
          <button type="button" class="btn btn-sm btn-ghost" data-photo-clear <%= form.photo_data ? '' : 'hidden' %>>Арилгах</button>
          <div class="hint">Нүүр царай тод харагдах зураг. Автоматаар дөрвөлжин болж багасна.</div>
          <input type="hidden" name="photo_data" value="<%= form.photo_data || '' %>" data-photo-data>
        </div>
      </div>
      <div class="form-grid">
        <div class="field">
          <label for="surname">Овог <span class="req">*</span></label>
          <input id="surname" type="text" name="surname" value="<%= form.surname || '' %>" maxlength="80" required>
        </div>
        <div class="field">
          <label for="name">Нэр <span class="req">*</span></label>
          <input id="name" type="text" name="name" value="<%= form.name || '' %>" maxlength="80" required>
        </div>
        <div class="field">
          <label>Хүйс <span class="req">*</span></label>
          <div class="seg">
            <label><input type="radio" name="gender" value="male" <%= form.gender === 'male' ? 'checked' : '' %> required> 👨 Эрэгтэй</label>
            <label><input type="radio" name="gender" value="female" <%= form.gender === 'female' ? 'checked' : '' %>> 👩 Эмэгтэй</label>
          </div>
        </div>
        <div class="field">
          <label for="phone">Утасны дугаар <span class="req">*</span></label>
          <input id="phone" type="tel" name="phone" value="<%= form.phone || '' %>" maxlength="20" autocomplete="username" required>
          <div class="hint">Нэвтрэхдээ энэ дугаарыг ашиглана.</div>
        </div>
        <div class="field">
          <label for="email">И-мэйл</label>
          <input id="email" type="email" name="email" value="<%= form.email || '' %>" maxlength="120">
        </div>
        <div class="field">
          <label for="school_id">Төгссөн сургууль <span class="req">*</span></label>
          <select id="school_id" name="school_id" required>
            <option value="">— Сургууль сонгох —</option>
            <%- include('../partials/school-options', { schools: schools, selected: form.school_id }) %>
          </select>
        </div>
        <div class="field">
          <label for="class_name">Анги</label>
          <input id="class_name" type="text" name="class_name" value="<%= form.class_name || '' %>" maxlength="20" placeholder="ж: 10А">
        </div>
        <%- include('../partials/city-field', { value: form.city }) %>
        <div class="field">
          <label for="facebook">Facebook линк</label>
          <input id="facebook" type="text" name="facebook" value="<%= form.facebook || '' %>" maxlength="300" placeholder="ж: facebook.com/таны.нэр" inputmode="url">
        </div>

        <div class="form-section-title">💼 Ажил хөдөлмөр</div>
        <div class="field">
          <label for="employment">Ажил эрхлэлтийн байдал <span class="req">*</span></label>
          <select id="employment" name="employment" required>
            <option value="">— Сонгох —</option>
            <% h.EMPLOYMENT.forEach(function (o) { %><option value="<%= o[0] %>" <%= form.employment === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
          </select>
        </div>
        <div class="field">
          <label for="workplace">Ажлын газар (байгууллага)</label>
          <input id="workplace" type="text" name="workplace" value="<%= form.workplace || '' %>" maxlength="150" placeholder="ж: Дорнод аймгийн Нэгдсэн эмнэлэг">
        </div>
        <div class="field">
          <label for="position_level">Албан тушаалын төрөл</label>
          <select id="position_level" name="position_level">
            <option value="">— Сонгох —</option>
            <% h.POSITION_LEVELS.forEach(function (o) { %><option value="<%= o[0] %>" <%= form.position_level === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
          </select>
        </div>
        <div class="field">
          <label for="position">Албан тушаал</label>
          <input id="position" type="text" name="position" value="<%= form.position || '' %>" maxlength="150" placeholder="ж: Хэлтсийн дарга, ахлах нягтлан">
        </div>

        <div class="form-section-title">🎓 Мэргэжил</div>
        <%- include('../partials/professions-field', { list: form.professions }) %>

        <div class="form-section-title">🔒 Нууц үг</div>
        <div class="field">
          <label for="password">Нууц үг <span class="req">*</span></label>
          <input id="password" type="password" name="password" minlength="8" autocomplete="new-password" required>
          <div class="hint">Дор хаяж 8 тэмдэгт.</div>
        </div>
        <div class="field">
          <label for="password2">Нууц үг давтах <span class="req">*</span></label>
          <input id="password2" type="password" name="password2" minlength="8" autocomplete="new-password" required>
        </div>
      </div>
      <p class="small faint">Бүртгүүлснээр таны нэр, зураг, сургууль, анги, ажил эрхлэлт, хот бусад баталгаажсан төгсөгчдөд харагдана. Утас, и-мэйл, Facebook линк зөвхөн эрх бүхий гишүүдэд харагдана. Бүртгэлийн дараах мэдээллийн өөрчлөлтийг админ хийнэ.</p>
      <button class="btn btn-primary btn-lg" type="submit">Бүртгүүлэх</button>
    </form>
    <hr class="sep">
    <p class="small muted">Бүртгэлтэй юу? <a href="/login">Нэвтрэх</a></p>
  </div>
</div>
<%- include('../partials/foot') %>
