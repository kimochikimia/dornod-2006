<%- include('partials/head') %>
<%
  var statusLabel = { done: 'Дууссан', active: 'Явагдаж буй', upcoming: 'Төлөвлөсөн' };
  var statusClass = { done: 'success', active: 'grad', upcoming: '' };
%>
<div class="container">
  <div class="page-head row between">
    <div>
      <h1>Төлөвлөгөө</h1>
    </div>
    <% if (can('manage_plans')) { %><a class="btn btn-primary" href="/admin/plans/new">+ Ажил нэмэх</a><% } %>
  </div>

  <% if (items.length) { %>
    <div class="plan-stats">
      <div class="card plan-stat">
        <div class="plan-stat-top"><span class="plan-stat-ic">📋</span><span class="label">Нийт ажил</span></div>
        <div class="num"><%= stats.total %></div>
        <div class="plan-bar" title="<%= stats.pct %>% дууссан">
          <i class="b-done" style="width:<%= stats.done / stats.total * 100 %>%"></i><i class="b-active" style="width:<%= stats.active / stats.total * 100 %>%"></i>
        </div>
        <div class="small muted"><%= stats.pct %>% гүйцэтгэл<% if (stats.milestones) { %> · <%= stats.milestones %> чухал үйл явдал<% } %></div>
      </div>
      <div class="card plan-stat is-done">
        <div class="plan-stat-top"><span class="plan-stat-ic">✅</span><span class="label">Дууссан</span></div>
        <div class="num"><%= stats.done %></div>
      </div>
      <div class="card plan-stat is-active">
        <div class="plan-stat-top"><span class="plan-stat-ic">⏳</span><span class="label">Явагдаж буй</span></div>
        <div class="num"><%= stats.active %></div>
      </div>
      <div class="card plan-stat is-upcoming">
        <div class="plan-stat-top"><span class="plan-stat-ic">🗓️</span><span class="label">Эхлээгүй</span></div>
        <div class="num"><%= stats.upcoming %></div>
        <% if (stats.next) { %>
          <div class="small muted plan-next" title="<%= stats.next.title %>">Дараагийнх: <strong><%= stats.next.title %></strong></div>
          <div class="small faint">📅 <%= stats.next.start_date.replace(/-/g, '.') %> · <%= stats.nextDays === 1 ? 'маргааш' : stats.nextDays + ' хоногийн дараа' %></div>
        <% } %>
      </div>
    </div>
  <% } %>

  <div class="tabs">
    <a class="tab <%= view === 'timeline' ? 'active' : '' %>" href="/plan?view=timeline">📍 Цагийн шугам</a>
    <a class="tab <%= view === 'monthly' ? 'active' : '' %>" href="/plan?view=monthly">🗓️ Сарын хуваарь</a>
  </div>

  <% if (!items.length) { %>
    <div class="empty">Одоогоор төлөвлөгөө оруулаагүй байна.</div>
  <% } %>

  <%# ---------- 1. Цагийн шугам ---------- %>
  <% if (timeline) { %><%- include('partials/plan-timeline', { timeline: timeline }) %><% } %>

  <%# ---------- 2. Сарын хуваарь ---------- %>
  <% if (monthly && items.length) { %>
    <%- include('partials/plan-monthly', { monthly: monthly }) %>
  <% } %>

  <%# ---------- Ажлын жагсаалт ---------- %>
  <% if (items.length) { %>
    <h2 style="margin-top:2rem">Ажлын жагсаалт</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Ажил</th><th>Эхлэх</th><th>Дуусах</th><th>Хугацаа</th><th>Хариуцагч</th><th>Төлөв</th></tr></thead>
        <tbody>
          <% items.forEach(function (i) { %>
            <tr>
              <td>
                <span class="dot" style="background:<%= i.color %>"></span>
                <strong><%= i.kind === 'milestone' ? '◆ ' : '' %><%= i.title %></strong>
                <% if (i.description) { %><div class="small muted"><%= i.description %></div><% } %>
                <% if (i.location || i.map_url) { %>
                  <div class="small">📍 <%= i.location || '' %><% if (i.map_url) { %><%= i.location ? ' · ' : '' %><a href="<%= i.map_url %>" target="_blank" rel="noopener noreferrer">Газрын зураг</a><% } %></div>
                <% } %>
              </td>
              <td class="small"><%= i.start_date.replace(/-/g, '.') %></td>
              <td class="small"><%= i.kind === 'milestone' ? '—' : i.end_date.replace(/-/g, '.') %></td>
              <td class="small"><%= i.kind === 'milestone' ? 'Чухал үе' : i.days + ' хоног' %></td>
              <td class="small"><%= i.responsible || '—' %></td>
              <td><span class="badge <%= statusClass[i.status] %>"><%= statusLabel[i.status] %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<%- include('partials/foot') %>
