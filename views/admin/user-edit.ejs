<%- include('../partials/head') %>
<div class="container">
  <%- include('_nav') %>
  <div class="card" style="margin-bottom:1.25rem">
    <div class="row between">
      <h2 style="margin:0"><%= user.surname %> <%= user.name %></h2>
      <span class="badge <%= user.status %>"><%= h.STATUS_LABELS[user.status] %></span>
    </div>
    <p class="small faint">Бүртгүүлсэн: <%= h.fmtDate(user.created_at) %></p>
    <form method="post" action="/admin/users/<%= user.id %>/photo" class="photo-picker" data-photo-picker style="margin-bottom:1.25rem">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="photo-preview" data-photo-preview>
        <% if (user.photo_v) { %><img src="/photos/<%= user.id %>?v=<%= user.photo_v %>" alt=""><% } else { %><span>📷</span><% } %>
      </div>
      <div class="row" style="gap:.5rem">
        <label class="btn btn-sm" for="photo_file">Зураг сонгох</label>
        <input id="photo_file" type="file" accept="image/jpeg,image/png,image/webp" data-photo-file hidden>
        <input type="hidden" name="photo_data" data-photo-data>
        <button class="btn btn-sm btn-primary" type="submit" name="action" value="save" data-photo-save hidden>Зураг хадгалах</button>
        <% if (user.photo_v) { %><button class="btn btn-sm btn-danger" type="submit" name="action" value="delete" formnovalidate>Зураг устгах</button><% } %>
      </div>
    </form>
    <form method="post" action="/admin/users/<%= user.id %>" class="form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="form-grid">
        <div class="field"><label>Овог</label><input type="text" name="surname" value="<%= user.surname %>" maxlength="80" required></div>
        <div class="field"><label>Нэр</label><input type="text" name="name" value="<%= user.name %>" maxlength="80" required></div>
        <div class="field"><label>Утас (нэвтрэх нэр)</label><input type="tel" name="phone" value="<%= user.phone %>" maxlength="20" required></div>
        <div class="field"><label>И-мэйл</label><input type="email" name="email" value="<%= user.email || '' %>" maxlength="120"></div>
        <div class="field"><label>Сургууль</label>
          <select name="school_id">
            <option value="">—</option>
            <%- include('../partials/school-options', { schools: schools, selected: user.school_id }) %>
          </select>
        </div>
        <div class="field"><label>Анги</label><input type="text" name="class_name" value="<%= user.class_name || '' %>" maxlength="20"></div>
        <div class="field"><label>Ажил эрхлэлтийн байдал</label>
          <select name="employment">
            <option value="">—</option>
            <% h.EMPLOYMENT.forEach(function (o) { %><option value="<%= o[0] %>" <%= user.employment === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
          </select>
        </div>
        <div class="field"><label>Ажлын газар</label><input type="text" name="workplace" value="<%= user.workplace || '' %>" maxlength="150"></div>
        <div class="field"><label>Мэргэжил</label><input type="text" name="occupation" value="<%= user.occupation || '' %>" maxlength="150"></div>
        <%- include('../partials/city-field', { value: user.city }) %>
        <div class="field"><label>Facebook линк</label><input type="text" name="facebook" value="<%= user.facebook || '' %>" maxlength="300" placeholder="facebook.com/нэр"></div>
        <div class="field"><label>Бүртгэлийн төлөв</label>
          <select name="status" <%= user.id === me.id || !can('approve_users') ? 'disabled' : '' %>>
            <% ['pending','approved','rejected'].forEach(function (s) { %><option value="<%= s %>" <%= user.status === s ? 'selected' : '' %>><%= h.STATUS_LABELS[s] %></option><% }) %>
          </select>
        </div>
        <div class="field"><label>Төлөв (эрх)</label>
          <select name="role" <%= user.id === me.id || !can('manage_roles') ? 'disabled' : '' %>>
            <% Object.keys(ROLE_LABELS).forEach(function (r) { %><option value="<%= r %>" <%= user.role === r ? 'selected' : '' %>><%= ROLE_LABELS[r] %></option><% }) %>
          </select>
          <% if (can('manage_roles')) { %><div class="hint">Төлөв бүрийн эрхийг <a href="/admin/roles">Эрх, төлөв</a> хэсэгт тохируулна.</div><% } %>
        </div>
      </div>
      <div class="field"><label>Танилцуулга</label><textarea name="bio" maxlength="3000"><%= user.bio || '' %></textarea></div>
      <div><button class="btn btn-primary" type="submit">Хадгалах</button></div>
    </form>
  </div>

  <div class="grid grid-2">
    <div class="card">
      <h3>Нууц үг шинэчлэх</h3>
      <p class="small muted">Төгсөгч нууц үгээ мартсан үед шинэ нууц үг тохируулж өгнө.</p>
      <form method="post" action="/admin/users/<%= user.id %>/password" class="row">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="text" name="password" minlength="8" placeholder="Шинэ нууц үг" required style="flex:1">
        <button class="btn" type="submit">Шинэчлэх</button>
      </form>
    </div>
    <% if (user.id !== me.id) { %>
      <div class="card">
        <h3>Устгах</h3>
        <p class="small muted">Бүртгэл болон түүний нэр дэвшүүлэлт, хүсэлтүүд устна. Сонгуульд өгсөн санал (тоо) хэвээр үлдэнэ.</p>
        <form method="post" action="/admin/users/<%= user.id %>/delete" data-confirm="Энэ хэрэглэгчийг бүр мөсөн устгах уу?">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-danger" type="submit">Хэрэглэгч устгах</button>
        </form>
      </div>
    <% } %>
  </div>
</div>
<%- include('../partials/foot') %>
