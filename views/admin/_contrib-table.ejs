<%# Аяны дэмжлэгийн хүснэгт. rows, k, what(c), actions: [[action, шошго, класс]] %>
<div class="table-wrap">
  <table>
    <thead><tr><th>Хандивлагч</th><th>Дэмжлэг</th><th>Сэтгэгдэл</th><th>Огноо</th><th></th></tr></thead>
    <tbody>
      <% rows.forEach(function (c) { %>
        <tr id="c<%= c.id %>">
          <td>
            <% if (c.user_id) { %><a href="/members/<%= c.user_id %>"><strong><%= c.display %></strong></a><% } else { %><strong><%= c.display %></strong> <span class="small faint">(бүртгэлгүй)</span><% if (c.donor_contact) { %><div class="small muted">📞 <%= c.donor_contact %></div><% } %><% } %>
            <% if (c.anonymous) { %><div class="small faint">🔒 нэрээ нууцалсан</div><% } %>
          </td>
          <td><%= what(c) %></td>
          <td class="small"><%= c.note || '—' %></td>
          <td class="small">
            <%= h.fmtDay(c.created_at) %>
            <% if (c.reviewed_by && c.status !== 'pending') { %><div class="faint">✓ <%= c.r_surname %> <%= c.r_name %></div><% } %>
          </td>
          <td>
            <form method="post" action="/admin/campaigns/<%= k.id %>/contributions/<%= c.id %>" class="row" style="gap:.35rem;flex-wrap:nowrap">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <% actions.forEach(function (a) { %>
                <button class="btn btn-sm <%= a[2] %>" type="submit" name="action" value="<%= a[0] %>"><%= a[1] %></button>
              <% }) %>
              <button class="btn btn-sm btn-danger" type="submit" name="action" value="delete" data-confirm="Энэ бүртгэлийг устгах уу?" title="Устгах" aria-label="Устгах">✕</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
