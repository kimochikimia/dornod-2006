<%- include('../partials/head') %>
<div class="container">
  <%- include('_nav') %>
  <div class="row between" style="margin-bottom:1rem">
    <h2 style="margin:0">Мэдээ, зарлал</h2>
    <a class="btn btn-primary" href="/admin/news/new">+ Шинэ мэдээ</a>
  </div>
  <% if (!news.length) { %>
    <div class="empty">Мэдээ алга.</div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Гарчиг</th><th>Огноо</th><th></th></tr></thead>
        <tbody>
          <% news.forEach(function (n) { %>
            <tr>
              <td><% if (n.pinned) { %><span class="badge grad">Онцлох</span> <% } %><a href="/news/<%= n.id %>"><%= n.title %></a></td>
              <td class="small muted"><%= h.fmtDate(n.created_at) %></td>
              <td>
                <div class="row" style="gap:.35rem;flex-wrap:nowrap">
                  <a class="btn btn-sm" href="/admin/news/<%= n.id %>">Засах</a>
                  <form method="post" action="/admin/news/<%= n.id %>/delete" class="inline" data-confirm="Энэ мэдээг устгах уу?">
                    <input type="hidden" name="_csrf" value="<%= csrf %>">
                    <button class="btn btn-sm btn-danger">Устгах</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<%- include('../partials/foot') %>
