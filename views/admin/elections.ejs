<%- include('../partials/head') %>
<div class="container">
  <%- include('_nav') %>
  <div class="row between" style="margin-bottom:1rem">
    <h2 style="margin:0">Сонгуулиуд</h2>
    <a class="btn btn-primary" href="/admin/elections/new">+ Шинэ сонгууль</a>
  </div>
  <% if (!elections.length) { %>
    <div class="empty">Сонгууль үүсгээгүй байна. "Шинэ сонгууль" товчоор удирдах зөвлөлийн сонгуулийг үүсгэнэ үү.</div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Нэр</th><th>Шат</th><th>Нэр дэвшигч</th><th>Санал</th><th></th></tr></thead>
        <tbody>
          <% elections.forEach(function (e) { %>
            <tr>
              <td><strong><%= e.title %></strong><div class="small faint"><%= h.fmtDay(e.created_at) %></div></td>
              <td><span class="badge <%= e.phase === 'voting' ? 'live' : '' %>"><%= h.PHASE_LABELS[e.phase] %></span></td>
              <td><%= e.candidate_count %></td>
              <td><%= e.ballot_count %></td>
              <td><div class="row" style="gap:.35rem;flex-wrap:nowrap"><a class="btn btn-sm btn-primary" href="/admin/elections/<%= e.id %>">Удирдах</a><a class="btn btn-sm" href="/elections/<%= e.id %>">Харах</a></div></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<%- include('../partials/foot') %>
