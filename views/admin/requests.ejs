<%- include('../partials/head') %>
<div class="container">
  <%- include('_nav') %>
  <h2>Төгсөгчдийн засварын хүсэлтүүд</h2>
  <% if (!requests.length) { %>
    <div class="empty">Хүсэлт алга.</div>
  <% } else { %>
    <div class="stack">
      <% requests.forEach(function (r) { %>
        <div class="card">
          <div class="row between">
            <div><a href="/admin/users/<%= r.user_id %>"><strong><%= r.surname %> <%= r.name %></strong></a> <span class="small muted">· <%= r.phone %> · <%= h.fmtDate(r.created_at) %></span></div>
            <span class="badge <%= r.status %>"><%= h.STATUS_LABELS[r.status] %></span>
          </div>
          <div class="prose" style="margin-top:.75rem"><%- h.text(r.message) %></div>
          <form method="post" action="/admin/requests/<%= r.id %>" class="row">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input type="text" name="admin_note" value="<%= r.admin_note || '' %>" maxlength="500" placeholder="Тайлбар (төгсөгчид харагдана)" style="flex:1;min-width:200px">
            <% if (r.status === 'open') { %>
              <button class="btn btn-success btn-sm" name="status" value="done">✓ Шийдвэрлэсэн</button>
            <% } else { %>
              <button class="btn btn-sm" name="status" value="done">Тайлбар хадгалах</button>
              <button class="btn btn-sm btn-ghost" name="status" value="open">Дахин нээх</button>
            <% } %>
          </form>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
<%- include('../partials/foot') %>
