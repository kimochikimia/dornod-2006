<%- include('../partials/head') %>
<%
  var e = event;
  var f = form || {};
  var seated = e.seating === 'seated';
  var phaseClass = { onsale: 'grad', soon: 'pending', soldout: 'danger', ended: '', draft: '' };
  var sections = [
    ['pending', 'Төлбөр хүлээгдэж буй', pending, 'Дансны хуулгаас гүйлгээний утга (код) болон дүнг тулгаад баталгаажуулна уу.'],
    ['paid', 'Төлсөн', paid, ''],
    ['cancelled', 'Цуцлагдсан', cancelled, 'Төлөх хугацаа нь дууссан эсвэл цуцлагдсан захиалга. Хожим төлсөн бол "Төлсөн" болгож сэргээнэ (суудал сул байвал).'],
  ];
%>
<div class="container">
  <%- include('_nav') %>

  <div class="row between" style="margin-bottom:1rem">
    <div>
      <a href="/admin/tickets" class="small">← Бүх арга хэмжээ</a>
      <h2 style="margin:.35rem 0 0"><%= e.title %></h2>
      <div class="small muted" style="margin-top:.25rem">
        <span class="badge <%= phaseClass[e.phase] %>"><%= tk.PHASE_LABELS[e.phase] %></span>
        &nbsp;🕒 <%= e.eventText %> · Худалдаа: <%= e.saleText %>
      </div>
    </div>
    <div class="row" style="gap:.5rem">
      <a class="btn" href="/tickets/<%= e.id %>">Нийтийн хуудас →</a>
      <% if (can('manage_tickets')) { %><a class="btn" href="/admin/tickets/<%= e.id %>/edit">✎ Засах<%= seated ? ' / план' : '' %></a><% } %>
    </div>
  </div>

  <% if (errors.length) { %><div class="flash error"><% errors.forEach(function (m) { %><div><%= m %></div><% }) %></div><% } %>

  <nav class="admin-subnav" aria-label="Тасалбарын ажлын хэсэг">
    <% if (can('sell_tickets')) { %><a href="/admin/tickets/<%= e.id %>/sell" class="<%= tab === 'sell' ? 'active' : '' %>">🎟️ Гараар тасалбар бичих</a><% } %>
    <% if (can('confirm_tickets')) { %><a href="/admin/tickets/<%= e.id %>" class="<%= tab === 'sales' ? 'active' : '' %>">📊 Тасалбар борлуулалт<% if (pending.length) { %> <span class="badge pending"><%= pending.length %></span><% } %></a><% } %>
  </nav>

  <% if (tab === 'sales') { %>
  <div class="grid grid-4" style="margin-bottom:1.25rem">
    <div class="card stat"><div class="num grad-text"><%= tk.fmtMoney(e.paid_amount) %></div><div class="label">Төлөгдсөн орлого</div></div>
    <div class="card stat"><div class="num"><%= e.paid_qty %><% if (e.total != null) { %><span class="small muted"> / <%= e.total %></span><% } %></div><div class="label">Зарагдсан тасалбар</div></div>
    <div class="card stat"><div class="num" style="color:<%= e.pending_qty ? 'var(--warn)' : 'inherit' %>"><%= e.pending_qty %></div><div class="label">Төлбөр хүлээгдэж буй</div></div>
    <div class="card stat"><div class="num"><%= e.left == null ? '∞' : e.left %></div><div class="label">Сул үлдсэн</div></div>
  </div>

  <div class="tk-search" data-order-search>
    <input type="search" placeholder="🔍 Код, захиалагчийн нэр эсвэл утсаар хайх…" aria-label="Захиалга хайх" autocomplete="off" data-order-q>
    <span class="small muted" data-order-hint></span>
  </div>

    <% sections.forEach(function (sec) { var rows = sec[2]; %>
      <section id="<%= sec[0] %>" style="margin-bottom:1.75rem">
        <h3><%= sec[1] %> <span class="muted small">(<span data-order-count><%= rows.length %></span>)</span></h3>
        <% if (!rows.length) { %>
          <p class="small faint">Алга.</p>
        <% } else { %>
          <% if (sec[3]) { %><p class="small muted"><%= sec[3] %></p><% } %>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Код</th><th>Захиалагч</th><th><%= seated ? 'Суудал' : 'Тоо' %></th><th>Дүн</th><th>Огноо</th><th></th></tr></thead>
              <tbody>
                <% rows.forEach(function (o) { %>
                  <tr data-order-row="<%= [o.code, o.buyer_name, o.buyer_phone || ''].join(' ').toLowerCase() %>">
                    <td><strong class="mono"><%= o.code %></strong></td>
                    <td>
                      <%= o.buyer_name %>
                      <% if (o.buyer_phone) { %><div class="small muted"><%= o.buyer_phone %></div><% } %>
                      <% if (!o.user_id) { %><div class="small faint">гараар бичсэн</div><% } %>
                      <% if (o.note) { %><div class="small cmp-note">“<%= o.note %>”</div><% } %>
                    </td>
                    <td class="small"><%= o.seatText || o.quantity %></td>
                    <td class="small"><strong><%= tk.fmtMoney(o.amount) %></strong></td>
                    <td class="small">
                      <%= h.fmtDate(o.created_at) %>
                      <% if (o.status === 'pending' && o.expires_at) { %><div class="faint">⏳ <%= h.fmtDate(o.expires_at) %> хүртэл</div><% } %>
                      <% if (o.status === 'cancelled' && o.cancel_reason) { %><div class="faint"><%= tk.CANCEL_LABELS[o.cancel_reason] %></div><% } %>
                      <% if (o.reviewed_at && o.r_name) { %><div class="faint">✓ <%= o.r_name %></div><% } %>
                    </td>
                    <td>
                      <form method="post" action="/admin/tickets/<%= e.id %>/orders/<%= o.id %>" class="row" style="gap:.35rem;flex-wrap:nowrap">
                        <input type="hidden" name="_csrf" value="<%= csrf %>">
                        <% if (o.status !== 'paid') { %><button class="btn btn-sm btn-primary" name="action" value="paid">✓ Төлсөн</button><% } %>
                        <% if (o.status !== 'cancelled') { %><button class="btn btn-sm" name="action" value="cancelled" data-confirm="<%= o.code %> захиалгыг цуцалж суудлыг чөлөөлөх үү?">Цуцлах</button><% } %>
                        <% if (o.status === 'cancelled') { %><button class="btn btn-sm btn-danger" name="action" value="delete" data-confirm="Захиалгыг бүр мөсөн устгах уу?">Устгах</button><% } %>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    <% }) %>
  <% } else { %>
    <div class="<%= seated ? 'cmp-layout' : 'tk-sell-solo' %>" style="margin-bottom:1.5rem">
      <% if (seated) { %>
        <div class="cmp-main">
          <section class="card">
            <div class="row between" style="margin-bottom:.5rem">
              <h3 style="margin:0">Суудлын байдал</h3>
              <div class="seat-legend small">
                <span><i class="sw free"></i>Сул</span><span><i class="sw sel"></i>Сонгосон</span>
                <span><i class="sw pending"></i>Хүлээгдэж буй</span><span><i class="sw paid"></i>Төлсөн</span>
              </div>
            </div>
            <div class="seat-map-wrap" data-seat-map data-mode="pick" data-form="sell-form">
              <script type="application/json" data-map-json><%- mapJson %></script>
            </div>
          </section>
        </div>
      <% } %>
      <aside class="cmp-side">
        <div class="card cmp-info">
          <div class="cmp-info-row"><span>🎟️ Сул үлдсэн</span><div><strong><%= e.left == null ? 'Хязгааргүй' : e.left %></strong><% if (e.total != null) { %> / <%= e.total %><% } %></div></div>
          <div class="cmp-info-row"><span>💳 Үнэ</span><div><%= e.priceText %></div></div>
        </div>
      <div class="card">
        <h3>Гараар тасалбар бичих</h3>
        <p class="small muted">Бэлнээр төлсөн эсвэл сайтад бүртгэлгүй хүнд.<%= seated ? ' Суудлыг план дээрээс сонгоно.' : '' %></p>
        <form method="post" action="/admin/tickets/<%= e.id %>/orders" class="form support-form" id="sell-form" data-price="<%= e.price %>">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="field"><label>Нэр</label><input type="text" name="buyer_name" value="<%= f.buyer_name || '' %>" maxlength="150" required></div>
          <div class="field"><label>Утас</label><input type="tel" name="buyer_phone" value="<%= f.buyer_phone || '' %>" maxlength="40"></div>
          <% if (seated) { %>
            <input type="hidden" name="seats" value="" data-pick-input>
            <div class="tk-picked" data-pick-list><span class="small faint">Суудал сонгоогүй байна.</span></div>
          <% } else { %>
            <div class="field">
              <label>Тасалбарын тоо</label>
              <div class="qty" data-qty>
                <button type="button" class="btn btn-sm" data-qty-step="-1" aria-label="Хасах">−</button>
                <input type="number" name="quantity" value="<%= f.quantity || 1 %>" min="1" max="100" inputmode="numeric">
                <button type="button" class="btn btn-sm" data-qty-step="1" aria-label="Нэмэх">+</button>
              </div>
            </div>
          <% } %>
          <div class="tk-total"><span>Нийт дүн</span><strong data-pick-total><%= seated ? '0₮' : tk.fmtMoney(e.price) %></strong></div>
          <div class="field"><label>Тэмдэглэл</label><input type="text" name="note" value="<%= f.note || '' %>" maxlength="500"></div>
          <label class="check"><input type="checkbox" name="paid" value="1" <%= f.buyer_name && !f.paid ? '' : 'checked' %>> Төлбөр төлөгдсөн</label>
          <button class="btn btn-primary" type="submit" <%= seated ? 'disabled' : '' %> data-pick-submit>Бүртгэх</button>
        </form>
      </div>
      </aside>
    </div>
  <% } %>
</div>
<script src="/js/seatmap.js" defer></script>
<script src="/js/tickets.js" defer></script>
<%- include('../partials/foot') %>
