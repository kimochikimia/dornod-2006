<%- include('../partials/head') %>
<div class="container">
  <%- include('_nav') %>
  <div class="row between" style="margin-bottom:1rem">
    <h2 style="margin:0">Аян хөтөлбөр</h2>
    <div class="row" style="gap:.5rem">
      <a class="btn" href="/campaigns">Нийтийн хуудас</a>
      <a class="btn btn-primary" href="/admin/campaigns/new">+ Шинэ аян</a>
    </div>
  </div>
  <% if (!campaigns.length) { %>
    <div class="empty">Аян хөтөлбөр алга. "+ Шинэ аян" товчоор нэмнэ үү.</div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Аян</th><th>Төлөв</th><th>Цугларсан / Зорилт</th><th>Дэмжигч</th><th>Хүлээгдэж буй</th><th></th></tr></thead>
        <tbody>
          <% campaigns.forEach(function (k) { %>
            <tr>
              <td><a href="/admin/campaigns/<%= k.id %>"><strong><%= k.title %></strong></a><% if (k.dates) { %><div class="small muted">📅 <%= k.dates %></div><% } %></td>
              <td><span class="badge <%= k.status === 'active' ? 'grad' : '' %>"><%= k.status === 'active' ? 'Явагдаж буй' : 'Дууссан' %></span></td>
              <td class="small"><%= cmp.fmtMoney(k.raised) %><%= k.goal_amount ? ' / ' + cmp.fmtMoney(k.goal_amount) + ' (' + k.percent + '%)' : '' %></td>
              <td class="small"><%= k.supporters %></td>
              <td><% if (k.pending) { %><a class="badge pending" href="/admin/campaigns/<%= k.id %>#pending"><%= k.pending %> шалгах</a><% } else { %><span class="small faint">—</span><% } %></td>
              <td>
                <div class="row" style="gap:.35rem;flex-wrap:nowrap">
                  <a class="btn btn-sm" href="/admin/campaigns/<%= k.id %>">Дэмжлэг</a>
                  <a class="btn btn-sm" href="/admin/campaigns/<%= k.id %>/edit">Засах</a>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<%- include('../partials/foot') %>
