<div class="field"><label>Сонгуулийн нэр</label><input type="text" name="title" value="<%= e.title %>" maxlength="200" required></div>
<div class="field">
  <label>Тайлбар, журам</label>
  <textarea name="description" rows="6" placeholder="Сонгуулийн зорилго, хуваарь, журам"><%= e.description || '' %></textarea>
</div>
<div class="form-grid">
  <div class="field">
    <label>Сонгогдох гишүүдийн тоо (суудал)</label>
    <input type="number" name="seats" min="1" max="50" value="<%= e.seats %>" required>
  </div>
  <div class="field">
    <label>Нэг сонгогчийн сонгох дээд тоо</label>
    <input type="number" name="max_choices" min="1" max="50" value="<%= e.max_choices %>" required>
    <div class="hint">Ихэвчлэн суудлын тоотой тэнцүү байна.</div>
  </div>
</div>
<div class="schedule-box">
  <label class="check"><input type="checkbox" name="auto_schedule" value="1" data-auto-schedule <%= e.auto_schedule ? 'checked' : '' %>> <strong>Хуваарийн дагуу автоматаар явуулах</strong></label>
  <p class="small faint" style="margin:.35rem 0 .9rem">Асаавал шат бүр доорх хугацаандаа өөрөө эхэлж, дуусна. Нэр дэвшүүлэх, зөвшөөрөл өгөх, санал өгөх үйлдлүүд зөвхөн тухайн хугацаанд нээлттэй байна. Хугацаа Улаанбаатарын цагаар.</p>
  <div class="schedule-grid" data-schedule-fields>
    <% [['nomination', '1. Нэр дэвшүүлэх'], ['acceptance', '2. Зөвшөөрөл авах'], ['voting', '3. Санал хураалт']].forEach(function (s) { %>
      <div class="schedule-row">
        <div class="schedule-label"><%= s[1] %></div>
        <div class="field"><label>Эхлэх</label><input type="datetime-local" name="<%= s[0] %>_start" value="<%= h.ubInput(e[s[0] + '_start']) %>"></div>
        <div class="field"><label>Дуусах</label><input type="datetime-local" name="<%= s[0] %>_end" value="<%= h.ubInput(e[s[0] + '_end']) %>"></div>
      </div>
    <% }) %>
    <p class="small faint" style="margin:0">Санал хураалт дуусахад сонгууль автоматаар хаагдаж, дүн нийтлэгдэнэ.</p>
  </div>
</div>
<label class="check"><input type="checkbox" name="show_live_results" value="1" <%= e.show_live_results ? 'checked' : '' %>> Санал хураалтын үеэр нэр дэвшигчдийн саналыг шууд харуулах</label>
<p class="small faint" style="margin:0">Унтраавал санал хураалтын үеэр зөвхөн ирц, сургуулиар оролцоо харагдаж, нэр дэвшигчдийн дүн сонгууль хаагдсаны дараа нийтлэгдэнэ.</p>
