<%- include('../partials/head') %>
<%
  var ro = ctxElection.status === 'superseded';
  // Бүтцэд ороогүй албан тушаалууд (засаж буй нэгжийнх нь өөрөө сонгогдоно)
  var usedPosts = flat.map(function (u) { return u.post_id; });
  var postOptions = function (self) {
    var html = '<option value="">— Албан тушаал сонгох —</option>';
    posts.forEach(function (p) {
      var mine = self && self.post_id === p.id;
      if (!mine && usedPosts.indexOf(p.id) !== -1) return;
      html += '<option value="' + p.id + '"' + (mine ? ' selected' : '') + '>' + h.escapeHtml(p.label + ' · ' + p.kindLabel) + '</option>';
    });
    return html;
  };
  var freePosts = posts.filter(function (p) { return usedPosts.indexOf(p.id) === -1; });
  // Эцэг: өөрийгөө болон доод албан тушаалуудаа сонгох боломжгүй
  var parentOptions = function (self, selected) {
    var blocked = self ? self.descendants.concat([self.id]) : [];
    var html = '<option value="">— Хамгийн дээд түвшин —</option>';
    flat.forEach(function (u) {
      if (blocked.indexOf(u.id) !== -1) return;
      html += '<option value="' + u.id + '"' + (u.id === selected ? ' selected' : '') + '>' +
        new Array(u.depth + 1).join('\u00A0\u00A0\u00A0') + h.escapeHtml(u.name) + '</option>';
    });
    return html;
  };
%>
<div class="container">
  <%- include('_nav') %>

  <div class="row between" style="margin-bottom:1rem">
    <h2 style="margin:0">Удирдах зөвлөлийн бүтэц</h2>
    <% if (ctxElection.status === 'current') { %><a class="btn" href="/board#structure">Нийтийн хуудас →</a><% } %>
  </div>

  <div class="flash info small" style="margin-bottom:1.25rem">
    Бүтцийг <a href="<%= eb %>/posts">Албан тушаал</a> хэсэгт үүсгэсэн албан тушаалуудаар зурна: албан тушаал бүрийг аль албан тушаалын доор байхыг сонгоно.
    Хүмүүс <a href="<%= eb %>/board">томилгооноос</a> автоматаар харагдана.
  </div>

  <% if (!ro) { %>
  <div class="card" style="margin-bottom:1.25rem">
    <h3 style="margin-top:0">＋ Бүтцэд албан тушаал нэмэх</h3>
    <% if (!posts.length) { %>
      <p class="muted" style="margin:0">Эхлээд <a href="<%= eb %>/posts">Албан тушаал</a> хэсэгт албан тушаал үүсгэнэ үү.</p>
    <% } else if (!freePosts.length) { %>
      <p class="muted" style="margin:0">Бүх албан тушаал бүтцэд орсон байна. Шинэ албан тушаалыг <a href="<%= eb %>/posts">Албан тушаал</a> хэсэгт үүсгэнэ.</p>
    <% } else { %>
      <form method="post" action="<%= eb %>/structure" class="unit-row">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="field"><label>Албан тушаал <span class="req">*</span></label><select name="post_id" required><%- postOptions(null) %></select></div>
        <div class="field"><label>Хэний доор</label><select name="parent_id"><%- parentOptions(null, null) %></select></div>
        <div class="field"><label>Дараалал</label><input type="number" name="sort_order" min="0" max="9999" placeholder="100"></div>
        <div class="unit-row-actions"><button class="btn btn-primary" type="submit">Нэмэх</button></div>
      </form>
      <div class="small faint" style="margin-top:.5rem">Дараалал: нэг албан тушаалын доорх албан тушаалуудын зүүнээс баруун тийшх эрэмбэ (бага нь зүүн талд).</div>
    <% } %>
  </div>
  <% } %>

  <% if (tree.length) { %>
    <div class="card" style="margin-bottom:1.25rem">
      <h3 style="margin-top:0">Харагдах байдал</h3>
      <%- include('../partials/board-structure', { tree: tree, openDialogs: false }) %>
    </div>
  <% } else if (posts.length) { %>
    <div class="empty">Бүтэц оруулаагүй байна. Эхлээд хамгийн дээд албан тушаалаа (ж: «Зөвлөлийн дарга») нэмнэ үү.</div>
  <% } %>

  <div class="stack" style="margin-top:1rem">
    <% flat.forEach(function (u) { %>
      <form method="post" action="<%= eb %>/structure/<%= u.id %>" class="card unit-row <%= u.missingPost ? 'waiting' : '' %>" id="u<%= u.id %>"
            style="margin-left:<%= Math.min(u.depth, 4) * 1.25 %>rem">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <fieldset class="contents" <%= ro ? 'disabled' : '' %>>
        <div class="field">
          <label><%= u.depth ? '└ ' : '' %>Албан тушаал<% if (u.missingPost) { %> <span style="color:var(--warn)">— «<%= u.name %>»-д албан тушаал сонгоно уу</span><% } %></label>
          <select name="post_id" required><%- postOptions(u) %></select>
        </div>
        <div class="field"><label>Хэний доор</label><select name="parent_id"><%- parentOptions(u, u.parent_id) %></select></div>
        <div class="field"><label>Дараалал</label><input type="number" name="sort_order" value="<%= u.sort_order %>" min="0" max="9999"></div>
        <div class="unit-row-actions">
          <% if (!ro) { %><button class="btn btn-primary btn-sm" type="submit">Хадгалах</button><% } %>
          <button class="btn btn-danger btn-sm" type="submit" formaction="<%= eb %>/structure/<%= u.id %>/delete" formnovalidate
                  data-confirm="&quot;<%= u.name %>&quot;-г бүтцээс хасах уу?<%= u.children.length ? ' Доорх албан тушаалууд нь нэг түвшин дээш шилжинэ.' : '' %>"
                  title="Бүтцээс хасах" aria-label="Бүтцээс хасах">✕</button>
        </div>
        </fieldset>
      </form>
    <% }) %>
  </div>
</div>
<%- include('../partials/foot') %>
