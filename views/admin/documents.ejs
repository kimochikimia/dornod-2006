<%- include('../partials/head') %>
<div class="container">
  <%- include('_nav') %>
  <div class="row between" style="margin-bottom:1rem">
    <h2 style="margin:0">Зөвлөлийн баримт бичиг</h2>
    <div class="row" style="gap:.5rem">
      <% if (ctxElection.status === 'current') { %><a class="btn" href="/board">Нийтийн хуудас →</a><% } %>
      <a class="btn btn-primary" href="<%= eb %>/documents/new">＋ Баримт бичиг нэмэх</a>
    </div>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>№</th><th>Баримт бичиг</th><th>Төлөв</th><th>Дугаар / огноо</th><th>Агуулга</th><th></th></tr></thead>
      <tbody>
        <% docs.forEach(function (d, i) { %>
          <tr>
            <td><%= i + 1 %></td>
            <td><strong><%= d.title %></strong><% if (d.purpose) { %><div class="small muted"><%= d.purpose %></div><% } %></td>
            <td><% if (d.status === 'approved') { %><span class="badge success">Батлагдсан</span><% } else { %><span class="badge pending">Батлагдаагүй</span><% } %></td>
            <td class="small"><%= [d.doc_number, d.approved_at].filter(Boolean).join(' · ') || '—' %></td>
            <td class="small">
              <% var parts = []; if (d.content_len) parts.push('📝 Текст'); if (d.file_name) parts.push('📎 ' + h.fmtSize(d.file_size)); %>
              <%= parts.join(' · ') || '—' %>
              <% if (d.draft_name) { %><div class="draft-chip">📄 Төсөл · <%= d.draft_at %></div><% } %>
              <% if (d.status !== 'approved' && (d.content_len || d.file_name)) { %>
                <div class="warn-chip" title="Эцсийн хувилбар оруулсан ч төлөв нь 'Батлагдаагүй' тул нийтэд харагдахгүй">⚠ Нийтэд харагдахгүй — батлаагүй</div>
              <% } %>
            </td>
            <td>
              <div class="row" style="gap:.35rem;flex-wrap:nowrap">
                <button type="button" class="btn btn-sm <%= d.draft_name ? 'btn-success' : '' %>" data-open-dialog="draft-<%= d.id %>">📄 Төсөл</button>
                <a class="btn btn-sm btn-primary" href="<%= eb %>/documents/<%= d.id %>">Засах</a>
                <a class="btn btn-sm" href="/board/documents/<%= d.id %>">Харах</a>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% docs.forEach(function (d) { %>
    <dialog id="draft-<%= d.id %>" class="dialog">
      <div class="dialog-body">
        <button type="button" class="modal-close" data-close-dialog aria-label="Хаах">&times;</button>
        <h3>Баримт бичгийн төсөл</h3>
        <p class="small muted"><strong><%= d.title %></strong></p>
        <%- include('_draft-box', { d: d, back: 'list' }) %>
      </div>
    </dialog>
  <% }) %>
</div>
<%- include('../partials/foot') %>
