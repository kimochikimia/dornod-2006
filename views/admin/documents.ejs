<%- include('../partials/head') %>
<div class="container">
  <%- include('_nav') %>
  <div class="row between" style="margin-bottom:1rem">
    <h2 style="margin:0">Зөвлөлийн баримт бичиг</h2>
    <div class="row" style="gap:.5rem">
      <a class="btn" href="/board">Нийтийн хуудас →</a>
      <a class="btn btn-primary" href="/admin/documents/new">＋ Баримт бичиг нэмэх</a>
    </div>
  </div>
  <p class="small muted">Зөвлөл баталсан баримт бичиг бүр дээр "Засах" дарж агуулга эсвэл файлаа оруулаад төлөвийг "Батлагдсан" болгоно. Батлагдаагүй баримт нийтэд зөвхөн нэр, зориулалтаараа харагдана.</p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>№</th><th>Баримт бичиг</th><th>Төлөв</th><th>Дугаар / огноо</th><th>Агуулга</th><th></th></tr></thead>
      <tbody>
        <% docs.forEach(function (d, i) { %>
          <tr>
            <td><%= i + 1 %></td>
            <td><strong><%= d.title %></strong><% if (d.purpose) { %><div class="small muted"><%= d.purpose %></div><% } %></td>
            <td><% if (d.status === 'approved') { %><span class="badge success">Батлагдсан</span><% } else { %><span class="badge pending">Батлагдаагүй</span><% } %></td>
            <td class="small"><%= [d.doc_number, d.approved_at].filter(Boolean).join(' · ') || '—' %></td>
            <td class="small"><%= d.content_len ? '📝 Текст' : '' %><%= d.content_len && d.file_name ? ' · ' : '' %><%= d.file_name ? '📎 ' + h.fmtSize(d.file_size) : '' %><%= !d.content_len && !d.file_name ? '—' : '' %></td>
            <td>
              <div class="row" style="gap:.35rem;flex-wrap:nowrap">
                <a class="btn btn-sm btn-primary" href="/admin/documents/<%= d.id %>">Засах</a>
                <a class="btn btn-sm" href="/board/documents/<%= d.id %>">Харах</a>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/foot') %>
