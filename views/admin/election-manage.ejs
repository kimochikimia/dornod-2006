<%- include('../partials/head') %>
<%
  var all = ['draft'].concat(PHASES);
  var cur = all.indexOf(e.phase);
  var hint = {
    draft: auto ? 'Хуваарийн дагуу нэр дэвшүүлэх шат эхлэхийг хүлээж байна (нийтэд "Эхлээгүй" гэж харагдана).' : 'Ноорог — зөвхөн удирдлагад харагдана.',
    nomination: 'Төгсөгчид өөрийгөө болон бусдыг нэр дэвшүүлж байна.',
    acceptance: 'Шинэ нэр дэвшүүлэлт хаагдсан. Нэр дэвшигчид зөвшөөрөх/татгалзах хариугаа өгнө.',
    voting: 'Санал хураалт явагдаж байна. Зөвхөн "Зөвшөөрсөн" нэр дэвшигчид саналын хуудсанд байна.',
    closed: 'Сонгууль дууссан. Үр дүн нийтэд харагдана.'
  };
%>
<div class="container">
  <%- include('_nav') %>

  <div class="card glow" style="margin-bottom:1.25rem">
    <div class="row between">
      <h2 style="margin:0">Сонгуулийн явц</h2>
      <a class="btn btn-sm" href="/elections/<%= e.id %>">Нийтийн хуудас →</a>
    </div>
    <p class="muted" style="margin-top:.5rem">Одоогийн шат: <span class="badge grad"><%= PHASE_LABELS[e.phase] %></span></p>
    <p class="small muted">
      Нэр дэвшигч: <strong style="color:<%= rd.active >= e.seats ? 'var(--success, #4ade80)' : 'var(--warn)' %>"><%= rd.active %> / <%= e.seats %></strong>
      · Зөвшөөрсөн: <strong style="color:<%= rd.accepted >= e.seats ? 'var(--success, #4ade80)' : 'var(--warn)' %>"><%= rd.accepted %> / <%= e.seats %></strong>
      · Санал өгсөн: <%= ballots %> · Доод ирц: <%= e.min_turnout %>%
    </p>
    <% if (blocked) { %><div class="flash warn small">⏸ Хуваарийн дагуу дараагийн шат эхлэх ёстой байсан ч зогслоо: <%= blocked %></div><% } %>
    <% if (!['voting', 'closed'].includes(e.phase) && rd.accepted < e.seats && !blocked) { %>
      <p class="small faint" style="margin:0">Санал хураалт эхлэхийн тулд зөвшөөрсөн нэр дэвшигч ядаж <%= e.seats %> байх ёстой.</p>
    <% } %>

    <% if (auto) { %>
      <h3 style="margin-top:1rem">⏱ Хуваарийн дагуу автоматаар явж байна</h3>
      <div class="schedule-view">
        <% var nextPhase = { draft: 'nomination', nomination: 'acceptance', acceptance: 'voting' }[e.phase];
           [['nomination', 'Нэр дэвшүүлэх'], ['acceptance', 'Зөвшөөрөл авах'], ['voting', 'Санал хураалт']].forEach(function (s) { %>
          <div class="schedule-item <%= e.phase === s[0] ? 'current' : '' %> <%= nextPhase === s[0] ? 'next' : '' %>">
            <strong><%= s[1] %></strong>
            <span class="small muted"><%= times[s[0]].start %> → <%= times[s[0]].end %></span>
            <% if (nextPhase === s[0]) { %>
              <form method="post" action="/admin/elections/<%= e.id %>/advance" data-confirm="&quot;<%= s[1] %>&quot; шатыг хугацаанаас нь өмнө яг одоо эхлүүлэх үү? Өмнөх шат одоо дуусна.">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <button class="btn btn-sm btn-primary" type="submit">▶ Одоо эхлүүлэх</button>
              </form>
            <% } %>
            <% if (s[0] === 'voting' && e.phase === 'voting') { %>
              <form method="post" action="/admin/elections/<%= e.id %>/advance" data-confirm="Санал хураалтыг хугацаанаас нь өмнө одоо дуусгаж, дүнг нийтлэх үү? Буцаах боломжгүй.">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <button class="btn btn-sm btn-danger" type="submit">⏹ Санал хураалтыг одоо дуусгах</button>
              </form>
            <% } %>
          </div>
        <% }) %>
      </div>
      <% if (deadline) { %>
        <p class="small" style="margin-top:.75rem"><%= deadline.label %>: <strong data-countdown="<%= deadline.at %>"></strong> <span class="faint">(<%= deadline.atText %>)</span></p>
      <% } %>
    <% } else { %>
    <h3 style="margin-top:1rem">Шат солих</h3>
    <div class="phase-controls">
      <% all.forEach(function (p, i) {
           var locked = ballots > 0 && i < all.indexOf('voting');
           if (p === e.phase) return; %>
        <form method="post" action="/admin/elections/<%= e.id %>/phase" class="inline"
              data-confirm="Сонгуулийг &quot;<%= PHASE_LABELS[p] %>&quot; шат руу шилжүүлэх үү?">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="phase" value="<%= p %>">
          <button class="btn btn-sm <%= i === cur + 1 ? 'btn-primary' : '' %>" <%= locked ? 'disabled' : '' %>>
            <%= i < cur ? '← ' : (i === cur + 1 ? 'Дараагийн шат: ' : '→ ') %><%= PHASE_LABELS[p] %>
          </button>
        </form>
      <% }) %>
    </div>
    <p class="small faint" style="margin-top:.75rem">Санал өгөгдсөний дараа өмнөх шатууд руу буцах боломжгүй.</p>
    <% } %>
  </div>

  <% var locked = e.phase === 'closed'; %>
  <details class="card settings-card" style="margin-bottom:1.25rem" <%= errors.length ? 'open' : '' %>>
    <summary>
      <h2>Тохиргоо</h2>
      <% if (locked) { %><span class="badge">🔒 Үр дүн гарсан — зөвхөн харах</span><% } %>
    </summary>
    <div style="margin-top:1rem">
      <% if (errors.length) { %><div class="flash error"><% errors.forEach(function (x) { %><div>• <%= x %></div><% }) %></div><% } %>
      <form method="post" action="/admin/elections/<%= e.id %>" class="form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <fieldset class="contents" <%= locked ? 'disabled' : '' %>>
          <%- include('_election-fields', { e: form }) %>
          <div><button class="btn btn-primary" type="submit">Хадгалах</button></div>
        </fieldset>
        <% if (locked) { %><p class="small muted" style="margin:0">Сонгуулийн үр дүн гарсан тул тохиргоог өөрчлөх боломжгүй.</p><% } %>
      </form>
    </div>
  </details>

  <div class="card" style="margin-bottom:1.25rem">
    <h2>Нэр дэвшигчид</h2>
    <% if (!candidates.length) { %>
      <p class="muted">Одоогоор нэр дэвшигч алга.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Нэр</th><th>Сургууль</th><th>Утас</th><th>Дэвшүүлсэн</th><th>Төлөв</th><th>Санал</th><th></th></tr></thead>
          <tbody>
            <% candidates.forEach(function (c) { %>
              <tr>
                <td><strong><%= c.surname %> <%= c.name %></strong></td>
                <td class="small"><%= c.school_name || '—' %></td>
                <td class="small"><%= c.phone %></td>
                <td><%= c.nomination_count %></td>
                <td><span class="badge <%= c.status %>"><%= h.STATUS_LABELS[c.status] %></span></td>
                <td><%= ['voting','closed'].includes(e.phase) ? c.votes : '—' %></td>
                <td>
                  <% if (!['voting','closed'].includes(e.phase)) { %>
                    <form method="post" action="/admin/elections/<%= e.id %>/candidates/<%= c.id %>" class="inline" data-confirm="Энэ нэр дэвшигчийг хасах уу?">
                      <input type="hidden" name="_csrf" value="<%= csrf %>">
                      <input type="hidden" name="action" value="remove">
                      <button class="btn btn-sm btn-danger">Хасах</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <% if (results) { %>
    <div class="card" style="margin-bottom:1.25rem" id="results">
      <div class="row between">
        <h2 style="margin:0">Сонгуулийн үр дүн — сонгогдсон гишүүд</h2>
        <% if (can('manage_board')) { %><a class="btn btn-sm" href="<%= eb %>/board">Томилгоо →</a><% } %>
      </div>
      <p class="small muted" style="margin:.5rem 0 1rem">
        <%= e.seats %> суудал · <%= results.winners.length %> гишүүн сонгогдсон · Санал өгсөн: <%= results.ballots %><%= results.eligible ? ' / ' + results.eligible + ' (' + results.turnout + '%)' : '' %>
      </p>
      <% if (results.invalid) { %>
        <div class="flash error small">✖ Ирц <%= results.turnout %>% нь шаардлагатай доод ирц <%= results.minTurnout %>%-д хүрээгүй тул сонгууль <strong>хүчингүй</strong>. Хэн ч сонгогдоогүй — өмнөх зөвлөл хүчинтэй хэвээр.</div>
      <% } %>
      <% if (results.tie) { %>
        <div class="flash warn small">⚖ Сүүлийн суудалд санал тэнцсэн — тухайн саналын тоонд түрүүлж хүрсэн нь сонгогдлоо.
          Сонгогдоогүй: <%= results.tiedOut.map(function (c) { return c.name + ' (' + c.votes + ' санал)'; }).join(', ') %>.</div>
      <% } %>
      <% if (!results.winners.length) { %>
        <p class="muted">Сонгогдсон гишүүн алга (санал аваагүй).</p>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead><tr><th>#</th><th>Гишүүн</th><th>Сургууль</th><th>Санал</th><th>Хувь</th><th>Зөвлөлд</th></tr></thead>
            <tbody>
              <% results.winners.forEach(function (w) { %>
                <tr>
                  <td><%= w.rank %></td>
                  <td>
                    <div class="row" style="gap:.6rem;flex-wrap:nowrap">
                      <%- avatar({ surname: w.surname, name: w.first_name, photo_v: w.photo_v }, w.user_id, 'xs') %>
                      <div><strong><%= w.name %></strong><% if (w.phone) { %><div class="small faint"><%= w.phone %></div><% } %></div>
                    </div>
                  </td>
                  <td class="small"><%= w.school || '—' %></td>
                  <td><strong><%= w.votes %></strong></td>
                  <td class="small"><%= w.pct %>%</td>
                  <td>
                    <% if (!w.member_id) { %><span class="badge">Нэмээгүй</span>
                    <% } else if (w.post === 'unassigned') { %><span class="badge pending">Томилогдоогүй</span>
                    <% } else { %><span class="badge success"><%= w.position %></span><% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  <% } %>

</div>
<%- include('../partials/foot') %>
