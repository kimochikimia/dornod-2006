<%- include('../partials/head') %>
<div class="container">
  <%- include('_nav') %>
  <div class="row between" style="margin-bottom:1rem">
    <h2 style="margin:0">Төлөвлөгөө</h2>
    <div class="row" style="gap:.5rem">
      <a class="btn" href="/plan">Нийтийн хуудас</a>
      <a class="btn" href="/admin/plans/new?kind=milestone">+ Чухал үе</a>
      <a class="btn btn-primary" href="/admin/plans/new">+ Ажил</a>
    </div>
  </div>
  <% if (!items.length) { %>
    <div class="empty">Төлөвлөгөө хоосон байна. "+ Ажил" эсвэл "+ Чухал үе" товчоор нэмнэ үү.</div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Нэр</th><th>Төрөл</th><th>Огноо</th><th>Хариуцагч</th><th></th></tr></thead>
        <tbody>
          <% items.forEach(function (i) { %>
            <tr>
              <td><span class="dot" style="background:<%= i.color %>"></span><strong><%= i.title %></strong><% if (i.location || i.map_url) { %><div class="small muted">📍 <%= i.location || '' %><% if (i.map_url) { %> <a href="<%= i.map_url %>" target="_blank" rel="noopener noreferrer">(газрын зураг)</a><% } %></div><% } %></td>
              <td class="small"><%= i.kind === 'milestone' ? '◆ Чухал үе' : 'Ажил' %></td>
              <td class="small"><%= i.range %></td>
              <td class="small"><%= i.responsible || '—' %></td>
              <td>
                <div class="row" style="gap:.35rem;flex-wrap:nowrap">
                  <a class="btn btn-sm" href="/admin/plans/<%= i.id %>">Засах</a>
                  <form method="post" action="/admin/plans/<%= i.id %>/delete" class="inline" data-confirm="&quot;<%= i.title %>&quot;-г устгах уу?">
                    <input type="hidden" name="_csrf" value="<%= csrf %>">
                    <button class="btn btn-sm btn-danger">Устгах</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<%- include('../partials/foot') %>
