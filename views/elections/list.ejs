<%- include('../partials/head') %>
<div class="container">
  <div class="page-head">
    <h1>Сонгууль</h1>
    <p>Төгсөгчдийн удирдах зөвлөлийн сонгууль: нэр дэвшүүлэх → зөвшөөрөл → санал хураалт → дүн.</p>
  </div>
  <% if (!elections.length) { %>
    <div class="empty">Одоогоор зарлагдсан сонгууль алга байна.</div>
  <% } else { %>
    <div class="grid grid-2">
      <% elections.forEach(function (e) { %>
        <a class="card card-link <%= ['voting','nomination','acceptance'].includes(e.phase) ? 'glow' : '' %>" href="/elections/<%= e.id %>">
          <div class="row" style="margin-bottom:.5rem">
            <% if (e.phase === 'voting') { %><span class="badge live">Санал хураалт явагдаж байна</span>
            <% } else { %><span class="badge <%= e.phase === 'closed' ? 'success' : '' %>"><%= e.phase === 'draft' && e.auto_schedule ? 'Эхлээгүй' : h.PHASE_LABELS[e.phase] %></span><% } %>
            <% if (e.auto_schedule && e.nomination_start) { %><span class="badge">⏱ <%= h.fmtDate(e.nomination_start) %> — <%= h.fmtDate(e.voting_end) %></span><% } %>
          </div>
          <h3><%= e.title %></h3>
          <p class="muted small" style="margin:0">
            <%= e.seats %> суудал · <%= e.accepted_count %> нэр дэвшигч · <%= e.ballot_count %> хүн санал өгсөн
          </p>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>
<%- include('../partials/foot') %>
