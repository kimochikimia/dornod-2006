<%- include('../partials/head') %>
<div class="container">
  <div class="page-head"><a href="/members" class="small">← Төгсөгчид</a></div>
  <div class="card glow" style="position:relative">
    <a class="modal-close" href="/members" data-modal-close aria-label="Хаах" title="Хаах">&times;</a>
    <% var canEdit = can('edit_users') && canTouch(member); %>
    <% if (canEdit) { %><a class="btn btn-sm member-edit-btn" href="/admin/users/<%= member.id %>">✎ Мэдээлэл засах</a><% } %>
    <div class="row" style="gap:1.25rem;margin-bottom:1.5rem">
      <%- avatar(member, member.id, 'lg') %>
      <div>
        <h1 class="member-title<%= canEdit ? ' has-edit' : '' %>" style="margin:0"><%= member.surname %> <%= member.name %><% if (member.short_name) { %> <span class="muted" style="font-weight:400">(<%= member.short_name %>)</span><% } %></h1>
        <div class="muted"><%= member.school_name || '—' %><%= member.class_name ? ' · ' + member.class_name + ' анги' : '' %></div>
        <% if (member.role !== 'member') { %><span class="badge grad" style="margin-top:.4rem"><%= ROLE_LABELS[member.role] %></span><% } %>
      </div>
    </div>
    <dl class="dl">
      <dt>Хүйс</dt><dd><%= member.gender ? h.GENDER_LABELS[member.gender] : '—' %></dd>
      <dt>Ажил эрхлэлт</dt><dd><%= member.employment ? h.EMPLOYMENT_LABELS[member.employment] : '—' %></dd>
      <dt>Ажлын газар</dt><dd><%= member.workplace || '—' %></dd>
      <dt>Албан тушаал</dt><dd><%= h.positionText(member) || '—' %></dd>
      <dt>Мэргэжил</dt><dd><% var profs = h.readProfessions(member); %><% if (profs.length) { %><% profs.forEach(function (p) { %><div><%= p.title || h.PROFESSION_LABELS[p.field] %><% if (p.field && p.title) { %> <span class="small muted">· <%= h.PROFESSION_LABELS[p.field] %></span><% } %></div><% }) %><% } else { %>—<% } %></dd>
      <dt>Амьдарч буй газар</dt><dd><%= member.city || '—' %></dd>
      <% if (can('view_contacts')) { %>
        <dt>Утас</dt><dd><a href="tel:<%= member.phone %>"><%= member.phone %></a></dd>
        <dt>И-мэйл</dt><dd><% if (member.email) { %><a href="mailto:<%= member.email %>"><%= member.email %></a><% } else { %>—<% } %></dd>
        <dt>Facebook</dt><dd><% if (member.facebook) { %><a class="fb-link" href="<%= member.facebook %>" target="_blank" rel="noopener noreferrer nofollow"><span class="fb-icon">f</span> Facebook хуудас</a><% } else { %>—<% } %></dd>
      <% } %>
      <dt>Бүртгүүлсэн</dt><dd><%= h.fmtDay(member.created_at) %></dd>
    </dl>
    <% if (member.bio) { %><hr class="sep"><div class="prose"><%- h.text(member.bio) %></div><% } %>
  </div>
</div>
<%- include('../partials/foot') %>
