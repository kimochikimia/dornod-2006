<%- include('../partials/head') %>
<div class="container">
  <div class="page-head"><a href="/members" class="small">← Төгсөгчид</a></div>
  <div class="card glow">
    <div class="row" style="gap:1.25rem;margin-bottom:1.5rem">
      <%- avatar(member, member.id, 'lg') %>
      <div>
        <h1 style="margin:0"><%= member.surname %> <%= member.name %></h1>
        <div class="muted"><%= member.school_name || '—' %><%= member.class_name ? ' · ' + member.class_name + ' анги' : '' %></div>
        <% if (member.role !== 'member') { %><span class="badge grad" style="margin-top:.4rem"><%= ROLE_LABELS[member.role] %></span><% } %>
      </div>
    </div>
    <dl class="dl">
      <dt>Ажил, мэргэжил</dt><dd><%= member.occupation || '—' %></dd>
      <dt>Амьдарч буй газар</dt><dd><%= member.city || '—' %></dd>
      <% if (can('view_contacts')) { %>
        <dt>Утас</dt><dd><a href="tel:<%= member.phone %>"><%= member.phone %></a></dd>
        <dt>И-мэйл</dt><dd><% if (member.email) { %><a href="mailto:<%= member.email %>"><%= member.email %></a><% } else { %>—<% } %></dd>
        <dt>Facebook</dt><dd><% if (member.facebook) { %><a class="fb-link" href="<%= member.facebook %>" target="_blank" rel="noopener noreferrer nofollow"><span class="fb-icon">f</span> Facebook хуудас</a><% } else { %>—<% } %></dd>
      <% } %>
      <dt>Бүртгүүлсэн</dt><dd><%= h.fmtDay(member.created_at) %></dd>
    </dl>
    <% if (member.bio) { %><hr class="sep"><div class="prose"><%- h.text(member.bio) %></div><% } %>
    <% if (can('edit_users') && canTouch(member)) { %><hr class="sep"><a class="btn btn-sm" href="/admin/users/<%= member.id %>">Мэдээлэл засах</a><% } %>
  </div>
</div>
<%- include('../partials/foot') %>
