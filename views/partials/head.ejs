<!DOCTYPE html>
<html lang="mn">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? title + ' · ' : '' %>Дорнод 2006 Төгсөгчид</title>
  <meta name="description" content="Дорнод аймгийн ерөнхий боловсролын сургуулиудыг 2006 онд төгссөн төгсөгчдийн нэгдсэн сайт.">
  <meta name="theme-color" content="#070914">
  <link rel="icon" href="/img/favicon-64.png" type="image/png">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/app.js" defer></script>
</head>
<body>
<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/" aria-label="Дорнод 2006 — нүүр"><img class="brand-logo" src="/img/logo-header.png" alt="Дорнод 2006" width="154" height="48"></a>
    <button class="help-btn help-btn-mobile" type="button" aria-label="Заавар" title="Заавар" aria-controls="help-drawer" aria-expanded="false" data-help-open>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5V5a2 2 0 0 1 2-2h13v16H6.5A2.5 2.5 0 0 0 4 21.5z"/><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H19"/><path d="M10 8.5a2 2 0 1 1 2.6 1.9c-.5.2-.6.5-.6 1V12"/><circle cx="12" cy="14.6" r=".4" fill="currentColor"/></svg>
    </button>
    <button class="nav-toggle" type="button" aria-label="Цэс" data-nav-toggle>☰</button>
    <div class="nav-menu" data-nav>
    <nav class="nav-links">
      <a href="/" class="<%= (path === '/' || path.startsWith('/news')) ? 'active' : '' %>">Нүүр</a>
      <a href="/members" class="<%= path.startsWith('/members') ? 'active' : '' %>">Төгсөгчид</a>
      <a href="/plan" class="<%= path.startsWith('/plan') ? 'active' : '' %>">Төлөвлөгөө</a>
      <a href="/campaigns" class="<%= path.startsWith('/campaigns') ? 'active' : '' %>">Аян хөтөлбөр</a>
      <a href="/tickets" class="<%= path.startsWith('/tickets') ? 'active' : '' %>">Тасалбар</a>
      <a href="/board" class="<%= path.startsWith('/board') || path.startsWith('/elections') ? 'active' : '' %>">Удирдах зөвлөл</a>
      <% if (canManage) { %>
        <a href="/admin" class="<%= path.startsWith('/admin') ? 'active' : '' %>"><%= me.role === 'admin' ? 'Админ' : 'Удирдлага' %></a>
      <% } %>
    </nav>
    <div class="nav-actions">
      <button class="help-btn" type="button" aria-label="Заавар" title="Заавар" aria-controls="help-drawer" aria-expanded="false" data-help-open>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5V5a2 2 0 0 1 2-2h13v16H6.5A2.5 2.5 0 0 0 4 21.5z"/><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H19"/><path d="M10 8.5a2 2 0 1 1 2.6 1.9c-.5.2-.6.5-.6 1V12"/><circle cx="12" cy="14.6" r=".4" fill="currentColor"/></svg>
      </button>
      <% if (me) { %>
        <a href="/me" class="nav-user <%= path === '/me' ? 'active' : '' %>"><%- avatar(me, me.id, 'xs') %><%= me.name %></a>
        <form method="post" action="/logout" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-sm btn-ghost" type="submit">Гарах</button>
        </form>
      <% } else { %>
        <a href="/login" class="btn btn-sm btn-ghost">Нэвтрэх</a>
        <a href="/register" class="btn btn-sm btn-primary">Бүртгүүлэх</a>
      <% } %>
    </div>
    </div>
  </div>
</header>
<%- include('help') %>
<main>
<% if (me && me.status === 'pending') { %>
  <div class="container flash-wrap"><div class="flash warn">Таны бүртгэл админы баталгаажуулалт хүлээж байна. Баталгаажсаны дараа төгсөгчдийн жагсаалт үзэх, нэр дэвшүүлэх, санал өгөх боломжтой болно.</div></div>
<% } %>
<% if (flash.length) { %>
  <div class="container flash-wrap">
    <% flash.forEach(function (f) { %><div class="flash <%= f.type %>"><%= f.message %></div><% }) %>
  </div>
<% } %>
