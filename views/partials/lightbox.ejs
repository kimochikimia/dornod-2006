<%# Зураг томоор харах цонх. [data-lightbox] холбоосууд [data-lightbox-group] дотор нэг цуваа болно. %>
<dialog class="lightbox" data-lightbox-dialog aria-label="Зураг">
  <button type="button" class="lb-close" data-lb-close aria-label="Хаах">&times;</button>
  <button type="button" class="lb-nav lb-prev" data-lb-prev aria-label="Өмнөх зураг">‹</button>
  <figure class="lb-figure">
    <img data-lb-img alt="">
    <figcaption><span data-lb-caption></span><small data-lb-count></small></figcaption>
  </figure>
  <button type="button" class="lb-nav lb-next" data-lb-next aria-label="Дараагийн зураг">›</button>
</dialog>
