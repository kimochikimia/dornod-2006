<%#
  Удирдах зөвлөлийн бүтэц (албан тушаалуудын модон схем).
  tree: board.loadStructure().tree — хүмүүс томилгооноос автоматаар харагдана.
  openDialogs: true бол хүн дээр дарахад тухайн гишүүний цонх (bm-<id>) нээгдэнэ.
%>
<%
  var linkPeople = typeof openDialogs !== 'undefined' && openDialogs;
  function orgNode(u, depth) {
%>
  <li style="flex-grow:<%= u.leaves || 1 %>">
    <div class="org-node <%= u.kind === 'head' || depth === 0 ? 'root' : '' %> <%= u.missingPost ? 'missing' : '' %>">
      <div class="org-name"><%= u.name %></div>
      <% if (u.people.length) { %>
        <div class="org-people">
          <% u.people.forEach(function (p) { %>
            <% if (linkPeople) { %><button type="button" class="org-person" data-open-dialog="bm-<%= p.member_id %>"><% } else { %><div class="org-person"><% } %>
              <%- avatar(p, p.user_id, 'xs') %>
              <span class="org-person-text"><strong><%= p.surname ? p.surname.charAt(0) + '. ' : '' %><%= p.name %></strong></span>
            <% if (linkPeople) { %></button><% } else { %></div><% } %>
          <% }) %>
        </div>
      <% } %>
      <% if (u.missingPost) { %>
        <div class="org-vacant">Албан тушаал сонгоогүй</div>
      <% } else if (u.vacant) { %>
        <div class="org-vacant"><%= u.people.length ? 'Сул орон тоо: ' + u.vacant : 'Томилогдоогүй' %></div>
      <% } %>
    </div>
    <% if (u.children.length) { %>
      <ul><% u.children.forEach(function (c) { orgNode(c, depth + 1); }) %></ul>
    <% } %>
  </li>
<% } %>
<div class="org-scroll" data-org>
  <ul class="org"><% tree.forEach(function (u) { orgNode(u, 0); }) %></ul>
</div>
