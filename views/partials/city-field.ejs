<%#
  Одоо амьдарч буй газар: Монголд (аймаг/нийслэл → сум/дүүрэг) эсвэл Гадаадад (улс).
  Хэрэглэх: include('city-field', { value: хадгалсан утга })
%><%
  var p = LOC.parsePlace(value);
  var where = p.where || '';
  var region = p.region || '';
  var sub = p.sub || '';
  var country = p.country || '';
  var subsJson = {};
  LOC.REGIONS.forEach(function (r) { subsJson[r[0]] = { list: r[1], kind: r[2] }; });
  var cur = region ? subsJson[region] : null;
%>
<div class="field city-field" data-place>
  <label>Одоо амьдарч буй газар</label>
  <script type="application/json" data-place-json><%- JSON.stringify(subsJson).replace(/</g, '\\u003c') %></script>
  <div class="seg">
    <label><input type="radio" name="place_where" value="mn" <%= where === 'mn' ? 'checked' : '' %>> 🏠 Монголд</label>
    <label><input type="radio" name="place_where" value="abroad" <%= where === 'abroad' ? 'checked' : '' %>> 🌐 Гадаадад</label>
  </div>
  <% if (p.raw) { %><div class="hint">Одоогийн бичлэг: <strong><%= p.raw %></strong> — шинээр сонгоогүй бол хэвээр үлдэнэ.</div><% } %>

  <div class="city-other" data-place-mn <%= where === 'mn' ? '' : 'hidden' %>>
    <select name="place_region" data-place-region aria-label="Аймаг, нийслэл">
      <option value="">— Аймаг, нийслэл сонгох —</option>
      <% LOC.REGIONS.forEach(function (r, i) { %>
        <% if (i === 2) { %><option disabled>──────────</option><% } %>
        <option value="<%= r[0] %>" <%= region === r[0] ? 'selected' : '' %>><%= r[0] === LOC.UB ? 'Улаанбаатар (нийслэл)' : r[0] + ' аймаг' %></option>
      <% }) %>
    </select>
    <select name="place_sub" data-place-sub aria-label="Сум, дүүрэг" <%= cur ? '' : 'disabled' %>>
      <option value=""><%= cur ? '— ' + (cur.kind === 'дүүрэг' ? 'Дүүрэг' : 'Сум') + ' (заавал биш) —' : '— Эхлээд аймаг, нийслэлээ сонгоно уу —' %></option>
      <% if (cur) cur.list.forEach(function (s) { %><option value="<%= s %>" <%= sub === s ? 'selected' : '' %>><%= s %> <%= cur.kind %></option><% }) %>
    </select>
  </div>

  <div class="city-other" data-place-abroad <%= where === 'abroad' ? '' : 'hidden' %>>
    <input type="search" placeholder="🔍 Улсаар хайх" data-filter-select="place_country" autocomplete="off">
    <select id="place_country" name="place_country" aria-label="Улс">
      <option value="">— Улс сонгох —</option>
      <optgroup label="Түгээмэл">
        <% LOC.POPULAR_COUNTRIES.forEach(function (c) { %><option value="<%= c %>" <%= country === c ? 'selected' : '' %>><%= c %></option><% }) %>
      </optgroup>
      <optgroup label="Бусад улс">
        <% LOC.OTHER_COUNTRIES.forEach(function (c) { %><option value="<%= c %>" <%= country === c ? 'selected' : '' %>><%= c %></option><% }) %>
      </optgroup>
    </select>
  </div>
</div>
