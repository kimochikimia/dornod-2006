<%- include('partials/head') %>
<div class="container">
  <div class="page-head row between">
    <div>
      <h1>Удирдах зөвлөл</h1>
    </div>
    <% if (can('manage_board')) { %><a class="btn" href="<%= boardElection ? '/admin/elections/' + boardElection.id + '/board' : '/admin/elections' %>">✎ Зөвлөл засах</a><% } %>
  </div>

  <%# ---------- Явагдаж буй / удахгүй эхлэх сонгууль ---------- %>
  <% active.forEach(function (e) { %>
    <a class="card card-link election-banner live-election" href="/elections/<%= e.id %>">
      <div>
        <div class="row" style="margin-bottom:.4rem;gap:.5rem">
          <% if (e.phase === 'voting') { %><span class="badge live">Санал хураалт явагдаж байна</span>
          <% } else { %><span class="badge grad"><%= e.phase === 'draft' ? 'Удахгүй эхэлнэ' : h.PHASE_LABELS[e.phase] %></span><% } %>
          <span class="badge">🗳️ Сонгууль<%= e.number ? " № " + e.number : "" %></span>
        </div>
        <h3 style="margin:0"><%= e.title %></h3>
        <% if (e.deadline) { %><p class="small muted" style="margin:.35rem 0 0"><%= e.deadline.label %>: <strong data-countdown="<%= e.deadline.at %>">—</strong></p><% } %>
      </div>
      <span class="btn btn-primary">Оролцох →</span>
    </a>
  <% }) %>

  <%# ---------- Зөвлөлийн гишүүд (бүлгээр, тойрог зурагтай) ---------- %>
  <%
    // Удирдлага: дарга/удирдлага төрлийн албан тушаалын аль нэгийг хашдаг гишүүд
    var groups = [
      { title: 'Удирдлага', test: function (m) { return m.lead; } },
      { title: 'Гишүүд', test: function (m) { return !m.lead && m.appts.length; } },
      { title: 'Томилгоо хүлээгдэж буй гишүүд', test: function (m) { return !m.appts.length; } }
    ];
  %>
  <section class="tile-section" id="members">
    <h2 class="tile-section-title joined">Удирдах зөвлөлийн бүрэлдэхүүн</h2>
    <div class="card joined-card">
      <% if (boardElection) { %>
        <a class="board-source" href="/elections/<%= boardElection.id %>">
          <span class="board-source-icon">🗳️</span>
          <span>
            <strong>№ <%= boardElection.number %></strong> сонгуулиар сонгогдсон зөвлөл
            <span class="small muted">· <%= boardElection.title %><%= boardElection.voting_ended_at ? ' · дүн гарсан ' + h.fmtDay(boardElection.voting_ended_at) : '' %> · <%= boardElection.seats %> суудал</span>
          </span>
          <span class="small">Үр дүн →</span>
        </a>
      <% } %>
      <% if (!members.length) { %>
        <div class="empty" style="border:0">Удирдах зөвлөлийн бүрэлдэхүүнийг удахгүй нийтэлнэ.</div>
      <% } %>
      <% var shown = groups.filter(function (g) { return members.some(g.test); }); %>
      <% shown.forEach(function (g) { var list = members.filter(g.test); %>
        <div class="tile-group">
          <% if (shown.length > 1) { %><h3 class="tile-group-title"><%= g.title %></h3><% } %>
          <div class="tiles">
            <% list.forEach(function (m) { %>
              <button type="button" class="member-tile <%= m.isHead ? 'chair' : '' %> <%= !m.appts.length ? 'waiting' : '' %>" data-open-dialog="bm-<%= m.id %>">
                <span class="tile-ring"><%- avatar(m, m.user_id, 'tile') %></span>
                <span class="tile-name"><%= m.surname %><br><%= m.name %></span>
                <span class="tile-post"><%= !m.appts.length ? 'Томилгоо хүлээгдэж буй' : m.appts.map(function (a) { return a.label; }).join(', ') %></span>
              </button>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <%# ---------- Зөвлөлийн бүтэц ---------- %>
  <% if (structure.length) { %>
    <section class="tile-section" id="structure">
      <h2 class="tile-section-title joined">Зөвлөлийн бүтэц</h2>
      <div class="card joined-card org-card">
        <%- include('partials/board-structure', { tree: structure, openDialogs: true }) %>
      </div>
    </section>
  <% } %>

  <%# Гишүүн бүрийн дэлгэрэнгүй (дарахад нээгдэнэ) %>
  <% members.forEach(function (m) { %>
    <dialog id="bm-<%= m.id %>" class="dialog member-dialog">
      <div class="dialog-body">
        <button type="button" class="modal-close" data-close-dialog aria-label="Хаах">&times;</button>
        <div class="member-dialog-head">
          <span class="tile-ring sm"><%- avatar(m, m.user_id, 'tile') %></span>
          <div style="min-width:0">
            <% if (!m.appts.length) { %><span class="badge pending">Томилгоо хүлээгдэж буй</span>
            <% } else { m.appts.forEach(function (a) { %><span class="badge grad"><%= a.label %></span> <% }); } %>
            <h3 style="margin:.4rem 0 .1rem"><%= m.surname %> <%= m.name %></h3>
            <div class="small muted"><%= m.school_name || '—' %><%= m.class_name ? ' · ' + m.class_name : '' %></div>
            <% if (m.occupation || m.city) { %><div class="small muted"><%= [m.occupation, m.city].filter(Boolean).join(' · ') %></div><% } %>
          </div>
        </div>
        <% var apptLines = m.appts.filter(function (a) { return a.appointed_at || a.decision; }); %>
        <% if (m.term || apptLines.length) { %>
          <div class="member-meta">
            <% if (m.term) { %><div>📅 Бүрэн эрх: <strong><%= m.term %></strong></div><% } %>
            <% apptLines.forEach(function (a) { %><div>📝 <%= a.label %>: <%= [a.appointed_at && a.appointed_at.replace(/-/g, '.'), a.decision].filter(Boolean).join(' · ') %></div><% }) %>
          </div>
        <% } %>
        <% if (m.phone || m.email || m.facebook) { %>
          <div class="board-contacts">
            <% if (m.phone) { %><a href="tel:<%= m.phone %>">📞 <%= m.phone %></a><% } %>
            <% if (m.email) { %><a href="mailto:<%= m.email %>">✉️ <%= m.email %></a><% } %>
            <% if (m.facebook) { %><a class="fb-link" href="<%= m.facebook %>" target="_blank" rel="noopener noreferrer nofollow"><span class="fb-icon">f</span> Facebook</a><% } %>
          </div>
        <% } %>
        <% if (me) { %><a class="btn btn-sm" href="/members/<%= m.user_id %>" style="justify-self:start">Профайл үзэх →</a><% } %>
      </div>
    </dialog>
  <% }) %>

  <%# ---------- Зөвлөлийн баримт бичиг (хамгийн дээр, 10 хавтас) ---------- %>
  <% if (documents.length) { var approvedCount = documents.filter(function (d) { return d.status === 'approved'; }).length; %>
    <section class="docs-section" style="margin-top:2.5rem">
      <div class="row between" style="margin-bottom:.9rem">
        <h2 style="margin:0">📁 Зөвлөлийн баримт бичиг</h2>
        <span class="small muted"><%= approvedCount %> / <%= documents.length %> батлагдсан</span>
      </div>
      <div class="folders">
        <% documents.forEach(function (d, i) { var ok = d.status === 'approved'; %>
          <a class="folder <%= ok ? 'approved' : 'draft' %> <%= !ok && d.has_draft ? 'has-draft' : '' %>" href="/board/documents/<%= d.id %>" title="<%= d.purpose || '' %>">
            <span class="folder-tab"><%= i + 1 %></span>
            <span class="folder-body">
              <span class="folder-title"><%= d.title %></span>
              <span class="folder-meta">
                <% if (ok) { %>✓ <%= d.approved_at || 'Батлагдсан' %><%= d.file_name ? ' · 📎' : '' %>
                <% } else if (d.has_draft) { %>📄 Төсөл хэлэлцэж байна
                <% } else { %>Батлагдаагүй<% } %>
              </span>
            </span>
          </a>
        <% }) %>
      </div>
    </section>
  <% } %>

  <%# ---------- Сонгуулийн түүх (тусдаа, хамгийн доор) ---------- %>
  <% if (others.length) { %>
    <section class="history-section" id="elections">
    <h2 style="margin-top:0">🗳️ Сонгуулийн түүх</h2>
    <div class="grid grid-2">
      <% others.forEach(function (e) { %>
        <a class="card card-link" href="/elections/<%= e.id %>">
          <div class="row" style="margin-bottom:.5rem;gap:.5rem">
            <span class="badge <%= e.phase === 'closed' ? 'success' : '' %>"><%= h.PHASE_LABELS[e.phase] %></span>
            <% if (e.voting_ended_at) { %><span class="badge">📅 <%= h.fmtDay(e.voting_ended_at) %></span><% } %>
          </div>
          <h3><%= e.title %></h3>
          <p class="muted small" style="margin:0"><%= e.seats %> суудал · <%= e.accepted_count %> нэр дэвшигч · <%= e.ballot_count %> хүн санал өгсөн</p>
        </a>
      <% }) %>
    </div>
    </section>
  <% } %>

</div>
<%- include('partials/foot') %>
