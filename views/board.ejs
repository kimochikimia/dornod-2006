<%- include('partials/head') %>
<div class="container">
  <div class="page-head row between">
    <div>
      <h1>Удирдах зөвлөл</h1>
      <p style="margin:0">Дорнод аймгийн 2006 оны төгсөгчдийн холбооны удирдах зөвлөлийн бүрэлдэхүүн, хариуцсан ажил.</p>
    </div>
    <% if (can('manage_board')) { %><a class="btn" href="/admin/board">✎ Зөвлөл засах</a><% } %>
  </div>

  <%# ---------- Зөвлөлийн баримт бичиг (хамгийн дээр, 10 хавтас) ---------- %>
  <% if (documents.length) { var approvedCount = documents.filter(function (d) { return d.status === 'approved'; }).length; %>
    <section class="docs-section">
      <div class="row between" style="margin-bottom:.9rem">
        <h2 style="margin:0">📁 Зөвлөлийн баримт бичиг</h2>
        <span class="small muted"><%= approvedCount %> / <%= documents.length %> батлагдсан</span>
      </div>
      <div class="folders">
        <% documents.forEach(function (d, i) { var ok = d.status === 'approved'; %>
          <a class="folder <%= ok ? 'approved' : 'draft' %>" href="/board/documents/<%= d.id %>" title="<%= d.purpose || '' %>">
            <span class="folder-tab"><%= i + 1 %></span>
            <span class="folder-body">
              <span class="folder-title"><%= d.title %></span>
              <span class="folder-meta">
                <% if (ok) { %>✓ <%= d.approved_at || 'Батлагдсан' %><%= d.file_name ? ' · 📎' : '' %>
                <% } else { %>Батлагдаагүй<% } %>
              </span>
            </span>
          </a>
        <% }) %>
      </div>
    </section>
  <% } %>

  <%# ---------- Явагдаж буй / удахгүй эхлэх сонгууль ---------- %>
  <% active.forEach(function (e) { %>
    <a class="card glow card-link election-banner" href="/elections/<%= e.id %>">
      <div>
        <div class="row" style="margin-bottom:.4rem;gap:.5rem">
          <% if (e.phase === 'voting') { %><span class="badge live">Санал хураалт явагдаж байна</span>
          <% } else { %><span class="badge grad"><%= e.phase === 'draft' ? 'Удахгүй эхэлнэ' : h.PHASE_LABELS[e.phase] %></span><% } %>
          <span class="badge">🗳️ Сонгууль</span>
        </div>
        <h3 style="margin:0"><%= e.title %></h3>
        <% if (e.deadline) { %><p class="small muted" style="margin:.35rem 0 0"><%= e.deadline.label %>: <strong data-countdown="<%= e.deadline.at %>">—</strong></p><% } %>
      </div>
      <span class="btn btn-primary">Оролцох →</span>
    </a>
  <% }) %>

  <%# ---------- Бүтэц ---------- %>
  <% var councilCount = members.length || seats; var unassigned = holders.unassigned.length; %>
  <section class="org card">
    <div class="org-node org-root">
      <strong>Нийт төгсөгчдийн нэгдэл</strong>
      <span>Дорнод аймгийн 2006 оны төгсөгчид</span>
    </div>
    <div class="org-arrow">↓</div>
    <div class="org-node org-council">
      <strong>Төгсөгчдийн зөвлөл<%= councilCount ? ' — ' + councilCount + ' гишүүн' : '' %></strong>
      <span>Нийтийн сонгуулиар сонгогдоно</span>
    </div>
    <div class="org-arrow">↓</div>
    <div class="org-posts">
      <% POSTS.filter(function (p) { return p.key !== 'unassigned'; }).forEach(function (p) {
           var hs = holders[p.key]; %>
        <div class="org-post <%= hs.length ? 'filled' : '' %>">
          <strong><%= p.key === 'member' ? 'Бусад зөвлөлийн гишүүд' : p.label %></strong>
          <span class="muted"><%= p.desc %></span>
          <div class="org-holders">
            <% if (hs.length) { %>
              <% hs.forEach(function (m) { %><span class="org-holder"><%- avatar(m, m.user_id, 'xs') %><%= m.surname.charAt(0) %>. <%= m.name %></span><% }) %>
            <% } else { %><span class="faint small">Томилогдоогүй</span><% } %>
          </div>
        </div>
      <% }) %>
    </div>
    <p class="org-note">Дарга болон үүрэг хариуцах гишүүдийг сонгогдсон зөвлөлийн анхны хурлаар тодруулна.<% if (unassigned) { %> Одоогоор <strong><%= unassigned %></strong> гишүүн томилгоо хүлээж байна.<% } %></p>
  </section>

  <%# ---------- Зөвлөлийн гишүүд (бүлгээр, тойрог зурагтай) ---------- %>
  <%
    var groups = [
      { title: 'Зөвлөлийн удирдлага', keys: ['chair', 'secretary', 'finance'] },
      { title: 'Зөвлөлийн гишүүд', keys: ['member'] },
      { title: 'Томилгоо хүлээгдэж буй гишүүд', keys: ['unassigned'] }
    ];
  %>
  <% if (!members.length) { %>
    <h2 style="margin-top:1.5rem">Зөвлөлийн гишүүд</h2>
    <div class="empty">Удирдах зөвлөлийн бүрэлдэхүүнийг удахгүй нийтэлнэ.</div>
  <% } %>
  <% groups.forEach(function (g) {
       var list = members.filter(function (m) { return g.keys.indexOf(m.post) !== -1; });
       if (!list.length) return; %>
    <section class="tile-section">
      <h2 class="tile-section-title"><%= g.title %></h2>
      <div class="tiles">
        <% list.forEach(function (m) { %>
          <button type="button" class="member-tile <%= m.post === 'chair' ? 'chair' : '' %> <%= m.post === 'unassigned' ? 'waiting' : '' %>" data-open-dialog="bm-<%= m.id %>">
            <span class="tile-ring"><%- avatar(m, m.user_id, 'tile') %></span>
            <span class="tile-name"><%= m.surname %><br><%= m.name %></span>
            <span class="tile-post"><%= m.post === 'unassigned' ? 'Томилгоо хүлээгдэж буй' : m.position %></span>
          </button>
        <% }) %>
      </div>
    </section>
  <% }) %>

  <%# Гишүүн бүрийн дэлгэрэнгүй (дарахад нээгдэнэ) %>
  <% members.forEach(function (m) {
       var duties = (m.responsibilities || '').split(/\r?\n/).map(function (l) { return l.replace(/^[\s•\-*]+/, '').trim(); }).filter(Boolean); %>
    <dialog id="bm-<%= m.id %>" class="dialog member-dialog">
      <div class="dialog-body">
        <button type="button" class="modal-close" data-close-dialog aria-label="Хаах">&times;</button>
        <div class="member-dialog-head">
          <span class="tile-ring sm"><%- avatar(m, m.user_id, 'tile') %></span>
          <div style="min-width:0">
            <% if (m.post === 'unassigned') { %><span class="badge pending">Томилгоо хүлээгдэж буй</span>
            <% } else { %><span class="badge grad"><%= m.position %></span><% } %>
            <h3 style="margin:.4rem 0 .1rem"><%= m.surname %> <%= m.name %></h3>
            <div class="small muted"><%= m.school_name || '—' %><%= m.class_name ? ' · ' + m.class_name : '' %></div>
            <% if (m.occupation || m.city) { %><div class="small muted"><%= [m.occupation, m.city].filter(Boolean).join(' · ') %></div><% } %>
          </div>
        </div>
        <% if (m.term || (m.post !== 'unassigned' && (m.appointed_at || m.decision))) { %>
          <div class="member-meta">
            <% if (m.term) { %><div>📅 Бүрэн эрх: <strong><%= m.term %></strong></div><% } %>
            <% if (m.post !== 'unassigned' && (m.appointed_at || m.decision)) { %><div>📝 Томилсон: <%= [m.appointed_at, m.decision].filter(Boolean).join(' · ') %></div><% } %>
          </div>
        <% } %>
        <% if (duties.length) { %>
          <div class="board-duties">
            <div class="board-duties-title">Хариуцсан ажил</div>
            <ul><% duties.forEach(function (l) { %><li><%= l %></li><% }) %></ul>
          </div>
        <% } else if (m.post !== 'unassigned') { %>
          <p class="small faint" style="margin:0">Хариуцсан ажлыг удахгүй нийтэлнэ.</p>
        <% } %>
        <% if (m.phone || m.email || m.facebook) { %>
          <div class="board-contacts">
            <% if (m.phone) { %><a href="tel:<%= m.phone %>">📞 <%= m.phone %></a><% } %>
            <% if (m.email) { %><a href="mailto:<%= m.email %>">✉️ <%= m.email %></a><% } %>
            <% if (m.facebook) { %><a class="fb-link" href="<%= m.facebook %>" target="_blank" rel="noopener noreferrer nofollow"><span class="fb-icon">f</span> Facebook</a><% } %>
          </div>
        <% } %>
        <% if (can('view_members')) { %><a class="btn btn-sm" href="/members/<%= m.user_id %>" style="justify-self:start">Профайл үзэх →</a><% } %>
      </div>
    </dialog>
  <% }) %>

  <%# ---------- Сонгуулийн түүх (хамгийн доор) ---------- %>
  <% if (others.length) { %>
    <h2 id="elections" style="margin-top:2.5rem">Сонгуулийн түүх</h2>
    <div class="grid grid-2">
      <% others.forEach(function (e) { %>
        <a class="card card-link" href="/elections/<%= e.id %>">
          <div class="row" style="margin-bottom:.5rem;gap:.5rem">
            <span class="badge <%= e.phase === 'closed' ? 'success' : '' %>"><%= h.PHASE_LABELS[e.phase] %></span>
            <% if (e.voting_ended_at) { %><span class="badge">📅 <%= h.fmtDay(e.voting_ended_at) %></span><% } %>
          </div>
          <h3><%= e.title %></h3>
          <p class="muted small" style="margin:0"><%= e.seats %> суудал · <%= e.accepted_count %> нэр дэвшигч · <%= e.ballot_count %> хүн санал өгсөн</p>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>
<%- include('partials/foot') %>
