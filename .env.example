# Локал хөгжүүлэлтэд .env болгон хуулж ашиглана. Railway дээр Variables хэсэгт оруулна.
NODE_ENV=development
PORT=3000

# Railway дээр: DATABASE_URL=${{MySQL.MYSQL_URL}}
DATABASE_URL=mysql://root:password@localhost:3306/dornod2006

# Урт, санамсаргүй тэмдэгт мөр (жишээ нь: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=change-me

# Админ (Бумцэнд Алтанхуяг, 8-р сургууль) — анх эхлэхэд автоматаар үүснэ
ADMIN_PHONE=99112233
ADMIN_PASSWORD=change-this-strong-password

# Имэйл (Gmail API). Хоосон бол имэйл илгээхгүй, сайт хэвийн ажиллана.
# GMAIL_REFRESH_TOKEN-ийг `npm run mail:auth` командаар авна.
MAIL_FROM=dornod2006@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Имэйл дэх холбоос, QR-ийн үндсэн хаяг (жишээ нь https://example.mn). Продакшнд заавал.
SITE_URL=
